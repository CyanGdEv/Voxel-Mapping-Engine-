+function mergePrefetchedDocuments(documents) {
+  const unique = new Map();
+  for (const document of documents || []) {
+    const url = normalizePortalUrl(document?.url || document?.transportUrl || "");
+    if (!safeHttpUrl(url)) continue;
+    const current = unique.get(url);
+    const candidate = { ...document, url };
+    if (!current || Number(candidate.score || 0) > Number(current.score || 0)) unique.set(url, candidate);
+  }
+  return [...unique.values()];
+}
+
+function emptyPlanningPrefetchBridge(status) {
+  return { status, runner: null, applications: [], documents: 0, warnings: [] };
+}
+
+function compactPlanningPrefetchBridge(result) {
+  return {
+    status: result.status,
+    runner: result.runner,
+    applications: result.applications.length,
+    documents: result.documents,
+    warnings: result.warnings
+  };
+}
+
+async function planningApplicationsFromPrefetch(runtime) {
+  if (!planningPrefetchDirectory(runtime)) return emptyPlanningPrefetchBridge("not-configured");
+  try {
+    const prefetch = await loadPlanningPrefetch(runtime);
+    const manifestApplications = Array.isArray(prefetch.manifest.applications) ? prefetch.manifest.applications : [];
+    const applications = [];
+    let documents = 0;
+    for (const application of manifestApplications) {
+      if (!application || application.failure) continue;
+      const reference = application.reference || null;
+      const applicationUrl = normalizePortalUrl(application.url || application.transportUrl || "");
+      const hints = mergePrefetchedDocuments([
+        ...(Array.isArray(application.documents) ? application.documents : []),
+        ...(Array.isArray(application.downloadedDocuments) ? application.downloadedDocuments : [])
+      ]).filter((document) => {
+        const normalized = normalizePortalUrl(document.url || document.transportUrl || "");
+        const entry = prefetch.entries.get(normalized) ||
+          prefetch.entries.get(legacyHttpAlias(normalized)) ||
+          prefetch.entries.get(canonicalHttpsAlias(normalized));
+        if (!entry || entry.kind !== "document") return false;
+        return !entry.applicationReference || !reference || entry.applicationReference === reference;
+      });
+      if (!safeHttpUrl(applicationUrl) || !hints.length) continue;
+      documents += hints.length;
+      applications.push({
+        id: `planning-prefetch:${reference || sha256(applicationUrl).slice(0, 16)}`,
+        reference,
+        status: application.status || "unknown",
+        documentationUrl: applicationUrl,
+        applicationUrl,
+        documentUrls: hints.map((document) => document.url),
+        prefetchedDocuments: hints,
+        portalProvider: "verified-planning-prefetch",
+        portalPriority: 1_000 + portalApplicationPriority(`${application.proposal || ""} ${application.status || ""}`),
+        portalRowText: String(application.proposal || "").slice(0, 1_000),
+        discoveryMethod: "verified-planning-prefetch",
+        prefetchRunner: prefetch.manifest.runner || prefetch.manifest.platform || "unknown"
+      });
+    }
+    return {
+      status: applications.length && documents ? "usable" : "no-linked-documents",
+      runner: prefetch.manifest.runner || prefetch.manifest.platform || "unknown",
+      applications,
+      documents,
+      warnings: applications.length && documents ? [] : ["Verified planning prefetch contained no application-linked document entries."]
+    };
+  } catch (error) {
+    return {
+      ...emptyPlanningPrefetchBridge("rejected"),
+      warnings: [`Planning prefetch application bridge rejected: ${error?.message || error}`]
+    };
+  }
+}
