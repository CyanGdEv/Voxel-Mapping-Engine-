+test("legacy AttachmentShowServlet links are downloadable candidates", () => {
+  const url = "https://publicaccess.example/portal/servlets/AttachmentShowServlet?ImageName=170690";
+  assert.equal(__test.looksDownloadable(url), true);
+  const candidate = __test.classifyDocumentCandidate({ url, linkText: "Approved Site Layout" });
+  assert.equal(candidate.downloadable, true);
+  assert.equal(candidate.role, "site-plan");
+});
+
+test("portal row extraction retains only matching park applications", () => {
+  const parsed = __test.extractPortalApplications(`
+    <table>
+      <tr><td><a href="/portal/servlets/ApplicationSearchServlet?PKID=100">SMD/2016/0315</a></td><td>Alton Towers, Farley Lane</td><td>New rollercoaster and landscaping</td><td>Planning Permission - Approved</td></tr>
+      <tr><td><a href="/portal/servlets/ApplicationSearchServlet?PKID=200">SMD/2016/0400</a></td><td>Unrelated site</td><td>Housing</td><td>Approved</td></tr>
+    </table>
+  `, "https://publicaccess.example/portal/servlets/MajorContentiousDevelopmentservlet", {
+    id: "test-authority",
+    rowPattern: /alton towers|farley lane/i,
+    applicationUrlPattern: /ApplicationSearchServlet\?PKID=/i,
+    referencePattern: /SMD\/\d{4}\/\d{4}/i
+  });
+  assert.equal(parsed.rowsConsidered, 2);
+  assert.equal(parsed.rowsMatched, 1);
+  assert.equal(parsed.applications[0].reference, "SMD/2016/0315");
+  assert.equal(parsed.applications[0].status, "approved");
+});
