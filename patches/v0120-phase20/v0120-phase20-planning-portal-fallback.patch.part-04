+        applicationUrlPattern: /ApplicationSearchServlet\?PKID=/i,
+        referencePattern: /SMD\/\d{4}\/\d{4}/i
+      }]
+    }, []);
+    assert.equal(evidence.portalFallback.applicationsFound, 1);
+    assert.equal(evidence.applicationsConsidered, 1);
+    assert.equal(evidence.documentsDownloaded, 1);
+    assert.equal(evidence.geometryCandidates, 1);
+    assert.equal(evidence.geometryExtractionQueue[0].status, "awaiting-georeference");
+    assert.equal(evidence.geometryExtractionQueue[0].applicationReference, "SMD/2022/0556");
+  } finally {
+    await new Promise((resolve) => server.close(resolve));
+  }
+});
