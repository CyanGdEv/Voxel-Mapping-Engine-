+{
+  "type": "FeatureCollection",
+  "name": "Implemented planning geometry example",
+  "source": {
+    "name": "Example local planning authority",
+    "url": "https://planning.example.gov/application/APP-2026-001",
+    "license": "Open Government Licence v3.0",
+    "dataset": "implemented-planning-layout",
+    "checked_at": "2026-08-05T00:00:00Z"
+  },
+  "features": [
+    {
+      "type": "Feature",
+      "geometry": {
+        "type": "Polygon",
+        "coordinates": [[[-1.9003, 52.9800], [-1.9000, 52.9800], [-1.9000, 52.9802], [-1.9003, 52.9802], [-1.9003, 52.9800]]]
+      },
+      "properties": {
+        "id": "planning:APP-2026-001:building-a",
+        "name": "Implemented building outline",
+        "kind": "building",
+        "subtype": "planning-derived-building",
+        "planning_reference": "APP-2026-001",
+        "planning_geometry_role": "as-built",
+        "planning_status": "implemented",
+        "planning_implemented": true,
+        "planning_confidence": 0.95,
+        "verified": true
+      }
+    },
+    {
+      "type": "Feature",
+      "geometry": {
+        "type": "LineString",
+        "coordinates": [[-1.9003, 52.9799], [-1.9001, 52.9800], [-1.8998, 52.9801]]
+      },
+      "properties": {
+        "id": "planning:APP-2026-001:path-a",
+        "name": "Implemented access path",
+        "kind": "path",
+        "subtype": "footway",
+        "surface": "paved",
+        "width": 4,
+        "planning_reference": "APP-2026-001",
+        "planning_geometry_role": "implemented-layout",
+        "planning_status": "implemented",
+        "planning_implemented": true,
+        "planning_confidence": 0.93,
+        "verified": true
+      }
+    }
+  ]
+}
