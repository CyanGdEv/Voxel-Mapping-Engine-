+async function acquirePlanningGeometry(runtime, filename) {
+  const resolved = path.resolve(filename);
+  const collection = await readJson(resolved);
+  invariant(collection?.type === "FeatureCollection" && Array.isArray(collection.features),
+    `--planning-geometry ${filename} must be a GeoJSON FeatureCollection`);
+  const defaults = planningCollectionSourceDefaults(collection);
+  invariant(defaults.sourceUrl, `--planning-geometry ${filename} requires collection source.url or feature source_url`);
+  invariant(defaults.license, `--planning-geometry ${filename} requires an explicit reuse licence`);
+  const provider = defaults.provider || "Planning application evidence";
+  const standardized = [];
+  for (const [index, feature] of collection.features.entries()) {
+    if (!feature?.geometry || !geometryIntersectsBbox(feature.geometry, runtime.bbox)) continue;
+    const properties = feature.properties || {};
+    const kind = properties.kind || inferGenericKind(properties, feature.geometry);
+    const role = normalizePlanningRole(properties.planning_geometry_role || properties.geometry_role);
+    invariant(role, `--planning-geometry ${filename} feature ${index} requires a supported planning_geometry_role`);
+    invariant(SUPPORTED_PLANNING_GEOMETRY_KINDS.has(kind),
+      `--planning-geometry ${filename} feature ${index} kind ${kind} cannot participate in planning authority fusion`);
+    const status = planningStatus(properties, "planning-geometry");
+    const implemented = planningImplemented(properties, role);
+    const confidence = firstNumber(properties, ["planning_confidence", "confidence"]) ??
+      (properties.verified === true ? 0.92 : 0.76);
+    const sourceUrl = properties.source_url || defaults.sourceUrl;
+    const license = properties.license || properties.source_license || defaults.license;
+    invariant(sourceUrl && license,
+      `--planning-geometry ${filename} feature ${index} requires source_url and license`);
+    standardized.push(standardizeFeature(feature, {
+      idPrefix: `planning-geometry:${path.basename(filename)}`,
+      index,
+      explicitId: properties.id || properties.planning_reference || null,
+      provider: properties.source_name || provider,
+      sourceUrl,
+      license,
+      dataset: properties.source_dataset || defaults.dataset || "planning-derived-geometry",
+      adapter: "planning-geometry",
+      kind,
+      subtype: properties.subtype || "planning-derived",
+      checkedAt: properties.checked_at || defaults.timestamp || new Date().toISOString(),
+      mergePolicy: ["authoritative-feature", "as-built", "implemented-layout", "approved-layout"].includes(role)
+        ? "planning-authority" : "planning-site",
+      heightM: firstNumber(properties, ["height_m", "height"]),
+      accuracyM: firstNumber(properties, ["accuracy_m"]),
+      extra: {
+        planning_authority: true,
+        planning_geometry_role: role,
+        planning_confidence: confidence,
+        planning_status: status,
+        planning_implemented: implemented,
+        planning_reference: firstString(properties, ["planning_reference", "reference", "application_reference"]),
+        planning_decision_date: firstString(properties, ["planning_decision_date", "decision_date", "decision-date"]),
+        planning_document_url: firstString(properties, ["planning_document_url", "document_url", "source_url"]),
+        verified: properties.verified === true
+      }
+    }));
