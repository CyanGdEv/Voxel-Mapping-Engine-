diff -ruN phase21_green/src/lib/planning-vectorize.mjs phase22_work/src/lib/planning-vectorize.mjs
--- phase21_green/src/lib/planning-vectorize.mjs	1970-01-01 00:00:00.000000000 +0000
+++ phase22_work/src/lib/planning-vectorize.mjs	2026-08-05 22:00:01.924990125 +0000
@@ -0,0 +1,382 @@
+import path from "node:path";
+import { createHash } from "node:crypto";
+import { createReadStream } from "node:fs";
+import { mkdir, readdir, readFile, rm, stat, writeFile } from "node:fs/promises";
+import { execFile, spawn } from "node:child_process";
+import { promisify } from "node:util";
+
+const execFileAsync = promisify(execFile);
+const DEFAULT_CURVE_TOLERANCE = 1.5;
+const LINE_ROLES = new Set(["ride-layout", "access-plan", "terrain-or-drainage", "lighting-plan", "site-plan", "block-plan", "landscape-plan"]);
+const POLYGON_ROLES = new Set(["site-plan", "block-plan", "landscape-plan", "ride-layout", "floor-plan", "terrain-or-drainage", "access-plan", "lighting-plan"]);
+
+export async function vectorizePlanningDrawings(runtime, options = {}, catalogue = {}) {
+  const mode = normalizeMode(options.planningVectorizeMode ||
+    (catalogue?.georeference?.accepted > 0 ? "extract" : "off"));
+  const config = {
+    mode,
+    maxDocuments: integer(options.planningVectorizeMaxDocuments, 30, 1, 200),
+    maxFeatures: integer(options.planningVectorizeMaxFeatures, 12_000, 1, 100_000),
+    maxFeaturesPerDocument: integer(options.planningVectorizeMaxFeaturesPerDocument, 2_000, 1, 20_000),
+    minLengthM: number(options.planningVectorizeMinLengthM, 2, 0.1, 100),
+    minAreaM2: number(options.planningVectorizeMinAreaM2, 4, 0.1, 10_000),
+    maxRmseM: number(options.planningVectorizeMaxRmseM, 3, 0.1, 25),
+    curveTolerance: number(options.planningVectorizeCurveTolerance, DEFAULT_CURVE_TOLERANCE, 0.1, 20),
+    failClosed: mode === "strict"
+  };
+  const report = {
+    schemaVersion: 1,
+    status: mode === "off" ? "disabled" : "active",
+    mode,
+    policy: {