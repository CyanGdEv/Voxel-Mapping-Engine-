+                                    off, qa, extract, or strict PDF vector extraction
+  --planning-vectorize-max-documents 30
+                                    Maximum accepted georeferenced drawings processed
+  --planning-vectorize-max-features 12000
+                                    Maximum evidence-only vector candidates per build
+  --planning-vectorize-max-features-per-document 2000
+                                    Per-drawing vector candidate ceiling
+  --planning-vectorize-min-length-m 2
+                                    Minimum extracted line length
+  --planning-vectorize-min-area-m2 4
+                                    Minimum extracted polygon area
+  --planning-vectorize-max-rmse-m 3
+                                    Maximum drawing alignment RMSE for vectorization
+  --planning-vectorize-curve-tolerance 1.5
+                                    PDF curve flattening tolerance in page points
   --planning-override-mode gated   off, gated, or authoritative OSM replacement policy
   --planning-override-min-confidence .86
                                     Minimum planning evidence score for automatic replacement
