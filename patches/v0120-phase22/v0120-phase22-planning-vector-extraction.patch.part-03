+function dedupeSequential(points){return points.filter((p,i)=>i===0||distance(p,points[i-1])>1e-6);}
+function coordinateKey(p){return `${p.x.toFixed(6)},${p.y.toFixed(6)}`;}
+function dedupeCoordinates(points){const map=new Map();for(const p of points)map.set(coordinateKey(p),p);return[...map.values()];}
+function polylineLength(points){let total=0;for(let i=1;i<points.length;i++)total+=distance(points[i-1],points[i]);return total;}
+function polygonArea(points){let total=0;for(let i=0;i<points.length;i++){const a=points[i],b=points[(i+1)%points.length];total+=a.x*b.y-b.x*a.y;}return total/2;}
+function samePoint(a,b){return a&&b&&Math.abs(a.x-b.x)<1e-9&&Math.abs(a.y-b.y)<1e-9;}
+function isPageFrame(shape,parsed){if(!shape.closed||shape.points.length<4)return false;const xs=shape.points.map((p)=>p.x),ys=shape.points.map((p)=>p.y);const width=Math.max(...xs)-Math.min(...xs),height=Math.max(...ys)-Math.min(...ys);return parsed.width>0&&parsed.height>0&&width>=parsed.width*.92&&height>=parsed.height*.92;}
+function safeKey(value){return String(value||"drawing").replace(/[^a-zA-Z0-9_-]+/g,"-").slice(0,80);}
+function camel(value){return String(value).replace(/-([a-z])/g,(_,c)=>c.toUpperCase());}
+function clamp(v,min,max){return Math.max(min,Math.min(max,v));}
+function count(object,key){object[key]=(object[key]||0)+1;}
+function sha256Text(value){return createHash("sha256").update(String(value)).digest("hex");}
+function integer(value,fallback,min,max){const n=value===undefined?fallback:Number(value);return Number.isInteger(n)&&n>=min&&n<=max?n:fallback;}
+function number(value,fallback,min,max){const n=value===undefined?fallback:Number(value);return Number.isFinite(n)&&n>=min&&n<=max?n:fallback;}
+function normalizeMode(value){const mode=String(value||"off").trim().toLowerCase();return["off","qa","extract","strict"].includes(mode)?mode:"off";}
+
+export const __test = { parseSvgDrawing, parsePathData, parseTransform, multiplyMatrices, classifyGeometryRole, collectVectorizableDocuments, vectorConfidence, transformAffine };
diff -ruN phase21_green/src/lib/report.mjs phase22_work/src/lib/report.mjs
--- phase21_green/src/lib/report.mjs	2026-08-05 21:52:54.000000000 +0000
+++ phase22_work/src/lib/report.mjs	2026-08-05 21:58:37.261924625 +0000
@@ -57,6 +57,7 @@
 - Overture overlap safeguards: ${map.sourceFusion?.overture?.duplicatesWithheld ?? 0} duplicate(s) and ${map.sourceFusion?.overture?.partialOverlapsWithheld ?? 0} partial overlap(s) withheld
 - Planning authority fusion: ${map.sourceFusion?.planningAuthority?.gapFilled ?? 0} missing feature(s) added, ${map.sourceFusion?.planningAuthority?.osmOverridden ?? 0} inaccurate OSM feature(s) replaced, ${map.sourceFusion?.planningAuthority?.corroborated ?? 0} OSM feature(s) corroborated, ${map.sourceFusion?.planningAuthority?.conflictsWithheld ?? 0} unsafe conflict(s) withheld
 - Planning documents: ${sources.supplemental?.evidence?.["planning-documents"]?.applicationsConsidered ?? 0} application(s) inspected, ${sources.supplemental?.evidence?.["planning-documents"]?.candidatesFound ?? 0} candidate file(s) found, ${sources.supplemental?.evidence?.["planning-documents"]?.documentsDownloaded ?? 0} cache-only download(s), ${sources.supplemental?.evidence?.["planning-documents"]?.textExtracted ?? 0} embedded-text extraction(s)
+- Planning vectors: ${sources.supplemental?.evidence?.["planning-documents"]?.vectorExtraction?.documentsExtracted ?? 0} drawing(s) vectorised, ${sources.supplemental?.evidence?.["planning-documents"]?.vectorExtraction?.featuresAccepted ?? 0} evidence-only feature candidate(s), ${sources.supplemental?.evidence?.["planning-documents"]?.vectorExtraction?.featuresWithheld ?? 0} unsafe/noise feature(s) withheld
 - OSM relation features assembled: ${map.topology?.relationFeatures ?? 0}
 - Disjoint polygon parts retained: ${map.topology?.polygonParts ?? 0}
