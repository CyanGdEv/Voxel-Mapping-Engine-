diff -ruN phase21_green/test/planning-vectorize.test.mjs phase22_work/test/planning-vectorize.test.mjs
--- phase21_green/test/planning-vectorize.test.mjs	1970-01-01 00:00:00.000000000 +0000
+++ phase22_work/test/planning-vectorize.test.mjs	2026-08-05 21:59:17.588523176 +0000
@@ -0,0 +1,111 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import path from "node:path";
+import { mkdtemp, mkdir, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { parseArgs } from "../src/lib/args.mjs";
+import { vectorizePlanningDrawings, __test } from "../src/lib/planning-vectorize.mjs";
+
+const affine = { a: 1, b: 0, c: 400000, d: 0, e: -1, f: 300000 };
+
+function catalogue(overrides = {}) {
+  const document = {
+    id: "planning-document:test",
+    downloaded: true,
+    rejected: false,
+    mime: "application/pdf",
+    role: "access-plan",
+    state: "approved",
+    score: 120,
+    sha256: "abc123",
+    cacheKey: "cache123",
+    url: "https://planning.example/approved-access-plan.pdf",
+    reuseStatus: "unknown-not-for-redistribution",
+    ...overrides.document
+  };
+  return {
+    applications: [{ reference: "SMD/2024/0001", status: "approved", documents: [document] }],
+    georeference: {
+      accepted: 1,
+      documents: [{
+        id: document.id,
+        status: "accepted",
+        method: "explicit-control-points",
+        page: 1,
+        rmseM: 0.4,
+        scaleMPerPoint: 1,
+        affine,
+        applicationReference: "SMD/2024/0001",
+        applicationStatus: "approved",
+        ...overrides.georeference
+      }]
+    }
+  };
+}
+
+test("planning vectorization CLI controls validate", () => {
+  const { options } = parseArgs(["build", "--planning-vectorize-mode", "extract", "--planning-vectorize-max-documents", "20", "--planning-vectorize-max-features", "5000", "--planning-vectorize-min-length-m", "1.5"]);
+  assert.equal(options.planningVectorizeMode, "extract");
+  assert.equal(options.planningVectorizeMaxDocuments, 20);
+  assert.equal(options.planningVectorizeMaxFeatures, 5000);
+  assert.throws(() => parseArgs(["build", "--planning-vectorize-mode", "guess"]), /off, qa, extract, or strict/);
+  assert.throws(() => parseArgs(["build", "--planning-vectorize-max-features", "0"]), /between 1 and 100000/);
+});
+
+test("SVG parser applies group transforms and retains open and closed geometry", () => {
+  const parsed = __test.parseSvgDrawing(`<svg width="100pt" height="80pt" viewBox="0 0 100 80"><g transform="translate(10 5)"><path d="M0 0 L20 0 L20 10" stroke="#000" fill="none"/><polygon points="30,10 50,10 50,30 30,30"/></g></svg>`);
+  assert.equal(parsed.shapes.length, 2);
+  assert.deepEqual(parsed.shapes[0].points[0], { x: 10, y: 5 });
+  assert.equal(parsed.shapes[0].closed, false);
+  assert.equal(parsed.shapes[1].closed, true);
+});
+
+test("Bezier path flattening is deterministic and preserves endpoints", () => {
+  const [part] = __test.parsePathData("M0 0 C10 0 10 10 20 10", 2);
+  assert.equal(part.curved, true);
+  assert.deepEqual(part.points[0], { x: 0, y: 0 });
+  assert.deepEqual(part.points.at(-1), { x: 20, y: 10 });
+  assert.ok(part.points.length >= 5);
+});
+
+test("document roles classify extracted lines and polygons conservatively", () => {
+  assert.equal(__test.classifyGeometryRole("access-plan", false), "access-path-centerline-candidate");
+  assert.equal(__test.classifyGeometryRole("ride-layout", false), "ride-centerline-candidate");
+  assert.equal(__test.classifyGeometryRole("floor-plan", true), "building-footprint-candidate");
+  assert.equal(__test.classifyGeometryRole("site-plan", false), "site-plan-linear-candidate");
+});
+
+test("unaccepted or high-error alignments are withheld", async () => {
+  const root = await mkdtemp(path.join(tmpdir(), "tpmap-vector-reject-"));
+  const report = await vectorizePlanningDrawings({ cacheDir: root }, { planningVectorizeMode: "extract", planningVectorizeMaxRmseM: 3 }, catalogue({ georeference: { rmseM: 9 } }));
+  assert.equal(report.featuresAccepted, 0);
+  assert.equal(report.documentsRejected, 1);
+  assert.equal(report.documents[0].reason, "georeference-rmse-exceeds-vectorization-limit");
+});
+
+test("accepted georeferenced vector PDF produces evidence-only path and footprint candidates", async () => {
+  const root = await mkdtemp(path.join(tmpdir(), "tpmap-vector-"));
+  const cache = path.join(root, "supplemental", "planning-documents");
+  await mkdir(cache, { recursive: true });
+  await writeFile(path.join(cache, "cache123.pdf"), "%PDF-1.4\n%%EOF\n");
+  const svg = `<svg width="100pt" height="100pt" viewBox="0 0 100 100">
+    <path d="M10 10 L40 10 L70 30" stroke="#333" stroke-width="2" fill="none"/>
+    <polygon points="20,40 50,40 50,70 20,70" stroke="#000" fill="none"/>
+    <rect x="0" y="0" width="100" height="100"/>
+  </svg>`;
+  const runtime = {
+    cacheDir: root,
+    planningVectorSvgProvider: async () => svg,
+    planningVectorCoordinateTransformer: async (points) => points.map((point) => ({ x: -1.9 + (point.x - 400000) / 100000, y: 53 + (point.y - 300000) / 100000 }))
+  };
+  const report = await vectorizePlanningDrawings(runtime, { planningVectorizeMode: "extract", planningVectorizeMinLengthM: 2, planningVectorizeMinAreaM2: 4 }, catalogue());
+  assert.equal(report.status, "candidate-vectors-extracted");
+  assert.equal(report.documentsExtracted, 1);
+  assert.equal(report.featuresAccepted, 2);
+  assert.equal(report.featuresWithheld, 1);
+  const roles = report.candidates.features.map((feature) => feature.properties.geometry_role).sort();
+  assert.deepEqual(roles, ["access-path-centerline-candidate", "access-surface-candidate"]);
+  assert.equal(report.candidates.features.every((feature) => feature.properties.world_eligible === false), true);
+  assert.equal(report.candidates.features.every((feature) => feature.properties.fusion_status === "awaiting-planning-authority-gates"), true);
+  assert.equal(report.candidates.features[0].properties.planning_reference, "SMD/2024/0001");
+});
