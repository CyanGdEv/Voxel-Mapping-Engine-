+  for (let index=0; index<parsed.shapes.length; index++) {
+    const shape = parsed.shapes[index];
+    if (isPageFrame(shape, parsed)) { withheld += 1; count(withheldReasons,"page-frame"); continue; }
+    const bng = shape.points.map((point) => transformAffine(pageToBng, point));
+    const lengthM = polylineLength(bng);
+    const areaM2 = shape.closed ? Math.abs(polygonArea(bng)) : 0;
+    if ((!shape.closed && lengthM < config.minLengthM) || (shape.closed && areaM2 < config.minAreaM2)) { withheld += 1; count(withheldReasons,"below-size-threshold"); continue; }
+    if (shape.closed && !POLYGON_ROLES.has(entry.document.role)) { withheld += 1; count(withheldReasons,"role-not-polygon-eligible"); continue; }
+    if (!shape.closed && !LINE_ROLES.has(entry.document.role)) { withheld += 1; count(withheldReasons,"role-not-line-eligible"); continue; }
+    const wgs84 = bng.map((point) => coordinateMap.get(coordinateKey(point))).filter(Boolean);
+    if (wgs84.length !== bng.length) { withheld += 1; count(withheldReasons,"coordinate-transform-incomplete"); continue; }
+    const role = classifyGeometryRole(entry.document.role, shape.closed);
+    const confidence = vectorConfidence(entry, shape, lengthM, areaM2);
+    features.push({
+      type: "Feature",
+      id: `planning-vector:${safeKey(entry.document.id)}:${index}`,
+      geometry: shape.closed ? { type: "Polygon", coordinates: [[...wgs84.map((p)=>[p.x,p.y]), ...(samePoint(wgs84[0],wgs84.at(-1))?[]:[[wgs84[0].x,wgs84[0].y]])]] } : { type: "LineString", coordinates: wgs84.map((p)=>[p.x,p.y]) },
+      properties: {
+        source_type: "planning-drawing-vector",
+        planning_reference: entry.document.applicationReference || entry.georeference.applicationReference || null,
+        application_status: entry.document.applicationStatus || entry.georeference.applicationStatus || "unknown",
+        document_id: entry.document.id,
+        document_role: entry.document.role,
+        document_state: entry.document.state || "unknown",
+        document_sha256: entry.document.sha256 || entry.georeference.sourceSha256 || null,
+        source_url: entry.document.url || entry.georeference.sourceUrl || null,
+        page: entry.georeference.page || 1,
+        extraction_method: "pdf-svg-vector",
+        geometry_role: role,
+        confidence,
+        georeference_method: entry.georeference.method,
+        georeference_rmse_m: entry.georeference.rmseM,
+        stroke_width_m: Math.round(shape.strokeWidth * (entry.georeference.scaleMPerPoint || 0) * 1000) / 1000,
+        length_m: Math.round(lengthM * 100) / 100,
+        area_m2: Math.round(areaM2 * 100) / 100,
+        curved_source: shape.curved,
+        reuse_status: entry.document.reuseStatus || entry.georeference.reuseStatus || "unknown-not-for-redistribution",
+        world_eligible: false,
+        fusion_status: "awaiting-planning-authority-gates"
+      }
+    });
+  }
+  return { features, withheld, withheldReasons };
+}
+
+function classifyGeometryRole(documentRole, closed) {
+  if (documentRole === "ride-layout") return closed ? "ride-footprint-candidate" : "ride-centerline-candidate";
+  if (documentRole === "access-plan") return closed ? "access-surface-candidate" : "access-path-centerline-candidate";
+  if (documentRole === "landscape-plan") return closed ? "landscape-polygon-candidate" : "landscape-boundary-candidate";
+  if (documentRole === "terrain-or-drainage") return closed ? "terrain-or-drainage-polygon-candidate" : "drainage-or-contour-line-candidate";
+  if (documentRole === "floor-plan") return closed ? "building-footprint-candidate" : "building-detail-line-candidate";
+  if (["site-plan", "block-plan"].includes(documentRole)) return closed ? "site-or-building-footprint-candidate" : "site-plan-linear-candidate";
+  if (documentRole === "lighting-plan") return closed ? "lighting-area-candidate" : "lighting-layout-line-candidate";
+  return closed ? "unknown-polygon-candidate" : "unknown-linear-candidate";
+}
+
+function vectorConfidence(entry, shape, lengthM, areaM2) {
+  let score = 0.52;
+  if (["approved", "as-built"].includes(entry.document.state)) score += 0.1;
+  if (["approved", "implemented", "granted"].includes(String(entry.document.applicationStatus || "").toLowerCase())) score += 0.08;
+  if (["ride-layout", "access-plan", "floor-plan", "landscape-plan"].includes(entry.document.role)) score += 0.08;
