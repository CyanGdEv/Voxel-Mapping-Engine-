+}
+
+function rejectDocument(report, entry, reason) { report.documentsRejected += 1; report.documents.push(documentReport(entry,{status:"rejected",reason})); }
+function documentReport(entry, extra) { return { documentId: entry.document.id, applicationReference: entry.document.applicationReference || entry.georeference.applicationReference || null, role: entry.document.role || null, sourceSha256: entry.document.sha256 || null, georeferenceMethod: entry.georeference.method || null, georeferenceRmseM: entry.georeference.rmseM ?? null, ...extra }; }
