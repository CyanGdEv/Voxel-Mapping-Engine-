+function flattenQuadratic(p0,p1,p2,tolerance){const estimated=distance(p0,p1)+distance(p1,p2);const steps=clamp(Math.ceil(estimated/Math.max(.25,tolerance)),3,96);const result=[];for(let i=1;i<=steps;i++){const t=i/steps,u=1-t;result.push({x:u*u*p0.x+2*u*t*p1.x+t*t*p2.x,y:u*u*p0.y+2*u*t*p1.y+t*t*p2.y});}return result;}
