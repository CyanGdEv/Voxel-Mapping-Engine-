+async function locateCachedDocument(cacheDirectory, document) { let entries; try{entries=await readdir(cacheDirectory,{withFileTypes:true});}catch{return null;} const keys=[document.cacheKey,document.sha256].filter(Boolean).map(String); const matches=entries.filter((e)=>e.isFile()&&keys.some((k)=>e.name.startsWith(k))).map((e)=>path.join(cacheDirectory,e.name)); const ranked=[]; for(const filename of matches){ranked.push({filename,size:(await stat(filename)).size});} ranked.sort((a,b)=>b.size-a.size); return ranked[0]?.filename||null; }
+async function transformCoordinates(points,sourceCrs,targetCrs){const input=points.map((p)=>`${p.x} ${p.y}`).join("\n")+"\n";const output=await spawnWithInput("gdaltransform",["-s_srs",sourceCrs,"-t_srs",targetCrs],input,60_000);const lines=output.trim().split(/\r?\n/).filter(Boolean);if(lines.length!==points.length)throw new Error("gdaltransform returned an unexpected coordinate count");return lines.map((line)=>{const [x,y]=line.trim().split(/\s+/).map(Number);if(![x,y].every(Number.isFinite))throw new Error("gdaltransform returned invalid coordinates");return{x,y};});}
+async function spawnWithInput(command,args,input,timeoutMs){return new Promise((resolve,reject)=>{const child=spawn(command,args,{stdio:["pipe","pipe","pipe"]});let stdout="",stderr="";const timer=setTimeout(()=>{child.kill("SIGKILL");reject(new Error(`${command} timed out`));},timeoutMs);child.stdout.setEncoding("utf8");child.stderr.setEncoding("utf8");child.stdout.on("data",(c)=>stdout+=c);child.stderr.on("data",(c)=>stderr+=c);child.on("error",(e)=>{clearTimeout(timer);reject(e);});child.on("close",(code)=>{clearTimeout(timer);code===0?resolve(stdout):reject(new Error(`${command} failed (${code}): ${stderr.trim()}`));});child.stdin.end(input);});}
+
+function parseStyle(attrs){const style={};const inline=attribute(attrs,"style");for(const item of String(inline||"").split(";")){const [k,v]=item.split(":").map((x)=>x?.trim());if(k)style[camel(k)]=v;}for(const key of ["stroke","fill","stroke-width","opacity","display","visibility"]){const value=attribute(attrs,key);if(value!==null)style[camel(key)]=value;}return style;}
+function attribute(attrs,name){const match=String(attrs||"").match(new RegExp(`\\b${name.replace(/[-/\\^$*+?.()|[\\]{}]/g,"\\$&")}\\s*=\\s*(?:"([^"]*)"|'([^']*)')`,"i"));return match?(match[1]??match[2]):null;}
+function parseTransform(value){let matrix=identityMatrix();for(const match of String(value||"").matchAll(/(matrix|translate|scale|rotate)\s*\(([^)]*)\)/gi)){const nums=parseNumberList(match[2])||[];let next=identityMatrix();if(match[1].toLowerCase()==="matrix"&&nums.length>=6)next=nums.slice(0,6);else if(match[1].toLowerCase()==="translate")next=[1,0,0,1,nums[0]||0,nums[1]||0];else if(match[1].toLowerCase()==="scale")next=[nums[0]??1,0,0,nums[1]??nums[0]??1,0,0];else if(match[1].toLowerCase()==="rotate"){const r=(nums[0]||0)*Math.PI/180,c=Math.cos(r),s=Math.sin(r);next=[c,s,-s,c,0,0];if(nums.length>=3)next=multiplyMatrices(multiplyMatrices([1,0,0,1,nums[1],nums[2]],next),[1,0,0,1,-nums[1],-nums[2]]);}matrix=multiplyMatrices(matrix,next);}return matrix;}
+function identityMatrix(){return[1,0,0,1,0,0];}
+function multiplyMatrices(a,b){return[a[0]*b[0]+a[2]*b[1],a[1]*b[0]+a[3]*b[1],a[0]*b[2]+a[2]*b[3],a[1]*b[2]+a[3]*b[3],a[0]*b[4]+a[2]*b[5]+a[4],a[1]*b[4]+a[3]*b[5]+a[5]];}
