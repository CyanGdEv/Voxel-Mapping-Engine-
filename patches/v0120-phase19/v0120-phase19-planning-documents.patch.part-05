+  try {
+    const evidence = await acquirePlanningDocumentEvidence({
+      cacheDir: path.join(root, "cache"), userAgent: "test"
+    }, {
+      planningDocuments: true, planningDocumentMode: "download", planningDocumentMinScore: 20
+    }, planningCollection({
+      planning_document_urls: [`http://127.0.0.1:${address.port}/approved-block-plan.pdf`]
+    }));
+    assert.equal(evidence.documentsDownloaded, 1);
