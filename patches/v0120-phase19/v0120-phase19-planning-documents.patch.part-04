+    return "document";
+  }
+}
+
+function decodeURIComponentSafe(value) {
+  try { return decodeURIComponent(value); } catch { return value; }
+}
+
+function decodeHtml(value) {
+  return String(value || "")
+    .replace(/&amp;/gi, "&")
+    .replace(/&quot;/gi, '"')
+    .replace(/&#39;|&apos;/gi, "'")
+    .replace(/&lt;/gi, "<")
+    .replace(/&gt;/gi, ">");
+}
+
+function stripHtml(value) {
+  return String(value || "").replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
+}
+
+function asUrlList(value) {
+  if (Array.isArray(value)) return value.flatMap(asUrlList);
+  if (!value) return [];
+  return String(value).split(/[;\n]+/).map((item) => item.trim()).filter((item) => /^https?:\/\//i.test(item));
+}
+
+function firstUrl(value) {
+  return asUrlList(value)[0] || null;
+}
+
+function uniqueUrls(values) {
+  return [...new Set(values.flatMap(asUrlList))];
+}
+
+function normalizeMode(value) {
+  const mode = String(value || "off").trim().toLowerCase();
+  return ["off", "discover", "download", "extract"].includes(mode) ? mode : "off";
+}
+
+function integer(value, fallback, minimum, maximum) {
+  const result = value === undefined ? fallback : Number(value);
+  return Number.isInteger(result) && result >= minimum && result <= maximum ? result : fallback;
+}
+
+function number(value, fallback, minimum, maximum) {
+  const result = value === undefined ? fallback : Number(value);
+  return Number.isFinite(result) && result >= minimum && result <= maximum ? result : fallback;
+}
+
+export const __test = {
+  collectPlanningApplications,
+  extractLinks,
+  classifyDocumentCandidate,
+  inferRole,
+  inferState,
+  safeHttpUrl,
+  looksDownloadable
+};
