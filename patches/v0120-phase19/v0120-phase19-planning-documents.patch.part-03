+    "block-plan": 82,
+    "landscape-plan": 78,
+    "ride-layout": 95,
+    "floor-plan": 62,
+    elevation: 58,
+    section: 58,
+    "terrain-or-drainage": 65,
+    "access-plan": 60,
+    "lighting-plan": 45,
+    "location-plan": 32,
+    "decision-notice": 20,
+    unknown: 0
+  })[role] ?? 0;
+}
