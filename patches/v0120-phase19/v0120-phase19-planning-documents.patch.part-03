+
+function inferRole(text) {
+  const value = String(text || "").toLowerCase();
+  if (/\b(site plan|proposed site|approved site|site layout|master ?plan|general arrangement|ga plan)\b/.test(value)) return "site-plan";
+  if (/\b(block plan)\b/.test(value)) return "block-plan";
+  if (/\b(location plan|red line|site location)\b/.test(value)) return "location-plan";
+  if (/\b(landscape|landscaping|planting plan|soft landscape|hard landscape)\b/.test(value)) return "landscape-plan";
+  if (/\b(ride layout|track layout|roller coaster|coaster layout)\b/.test(value)) return "ride-layout";
+  if (/\b(floor plan|ground floor|first floor|roof plan)\b/.test(value)) return "floor-plan";
+  if (/\b(elevation|facade)\b/.test(value)) return "elevation";
+  if (/\b(section|cross section|longitudinal section)\b/.test(value)) return "section";
+  if (/\b(drainage|levels plan|contours?|topographic|topographical)\b/.test(value)) return "terrain-or-drainage";
+  if (/\b(lighting|illumination)\b/.test(value)) return "lighting-plan";
+  if (/\b(access plan|highway layout|road layout|parking layout)\b/.test(value)) return "access-plan";
+  if (/\b(decision notice|grant of permission|planning decision)\b/.test(value)) return "decision-notice";
+  return "unknown";
+}
+
+function inferState(text) {
+  const value = String(text || "").toLowerCase();
+  if (/\bsuperseded|obsolete|withdrawn\b/.test(value)) return "superseded";
+  if (/\bas[- ]?built|implemented|completion\b/.test(value)) return "as-built";
+  if (/\bapproved|granted|decision notice\b/.test(value)) return "approved";
+  if (/\bproposed\b/.test(value)) return "proposed";
+  if (/\bexisting\b/.test(value)) return "existing";
+  return "unknown";
+}
+
+function roleScore(role) {
+  return ({
