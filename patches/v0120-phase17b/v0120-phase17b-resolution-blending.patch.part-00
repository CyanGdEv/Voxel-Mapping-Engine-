@@ -88,6 +88,13 @@ Public service consent
   --ea-tile-max-resolution-m 2      Reject unexpectedly coarse EA tile responses
   --ea-tile-threshold-m 1500        Tile requests whose longest side exceeds this
   --ea-tile-fallback-single         Controlled fallback to one WCS request if tiling fails
+  --ea-resolution-blend             Use high detail at the park and coarser outer terrain
+  --ea-resolution-core-bbox BBOX    Original park bounds used for the highest-detail zone
+  --ea-core-resolution-m 1          Requested DTM/DSM resolution for tiles intersecting the park
+  --ea-near-resolution-m 2          Requested resolution in the near-context ring
+  --ea-outer-resolution-m 5         Requested resolution in the outer context
+  --ea-near-distance-m 750          Near-context distance from the park bounds
+  --ea-resolution-feather-m 64      Blend distance across resolution boundaries
   --ea-index-wfs-url URL            Replaceable LiDAR survey-index WFS
   --cache DIRECTORY                 Response cache (default .tpmap-cache)
   --no-cache                        Refresh bounded source requests
