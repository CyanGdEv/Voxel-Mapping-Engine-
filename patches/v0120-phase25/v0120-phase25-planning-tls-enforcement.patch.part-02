+import test from "node:test";
+import assert from "node:assert/strict";
+import { enforcePlanningCoverage } from "../src/lib/planning-coverage.mjs";
+
+function sources(policy, passed = false) {
+  return { supplemental: { evidence: { "planning-documents": { coverage: {
+    policy, passed, message: "Planning coverage failed: live applications 0/1"
+  } } } } };
+}
+
+test("resolved fail policy is enforced when the CLI flag was implicit", () => {
+  assert.throws(() => enforcePlanningCoverage(sources("fail"), {}), (error) => {
+    assert.equal(error.code, "PLANNING_COVERAGE_FAILED");
