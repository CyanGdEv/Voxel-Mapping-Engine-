diff -ruN phase25_base/src/lib/planning-coverage.mjs phase25_work/src/lib/planning-coverage.mjs
--- phase25_base/src/lib/planning-coverage.mjs	1970-01-01 00:00:00.000000000 +0000
+++ phase25_work/src/lib/planning-coverage.mjs	2026-08-06 06:34:25.705226843 +0000
@@ -0,0 +1,12 @@
+import { UserError } from "./errors.mjs";
+
+export function enforcePlanningCoverage(sources, options = {}) {
+  const coverage = sources.supplemental?.evidence?.["planning-documents"]?.coverage;
+  if (!coverage || coverage.passed !== false) return;
+  const resolvedPolicy = options.planningCoveragePolicy || coverage.policy || "warn";
+  if (resolvedPolicy !== "fail") return;
+  const error = new UserError(coverage.message || "Planning coverage failed.");
+  error.code = "PLANNING_COVERAGE_FAILED";
+  error.details = coverage;
+  throw error;
+}
