@@ -216,6 +220,21 @@
   ]) {
     if (options[key] === undefined) continue;
     if (options[key] < minimum || options[key] > maximum || (integerOnly && !Number.isInteger(options[key]))) {
+      throw new UserError(`--${toKebab(key)} must be ${integerOnly ? "an integer " : ""}between ${minimum} and ${maximum}`);
+    }
+  }
+  if (options.planningVectorFusionMode && !["off", "review", "gated", "private", "authoritative"].includes(options.planningVectorFusionMode)) {
+    throw new UserError("--planning-vector-fusion-mode must be off, review, gated, private, or authoritative");
+  }
+  for (const [key, minimum, maximum, integerOnly] of [
+    ["planningVectorFusionMinConfidence", 0, 1, false],
+    ["planningVectorFusionMaxRmseM", 0.1, 25, false],
+    ["planningVectorFusionMinLengthM", 0.1, 200, false],
+    ["planningVectorFusionMinAreaM2", 0.1, 100000, false],
+    ["planningVectorFusionMaxFeatures", 1, 100000, true]
+  ]) {
+    if (options[key] === undefined) continue;
+    if (options[key] < minimum || options[key] > maximum || (integerOnly && !Number.isInteger(options[key]))) {
       throw new UserError(`--${toKebab(key)} must be ${integerOnly ? "an integer " : ""}between ${minimum} and ${maximum}`);
     }
   }
