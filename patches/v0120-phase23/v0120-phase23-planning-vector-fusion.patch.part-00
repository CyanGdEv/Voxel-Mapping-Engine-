+const SUPPORTED_VECTOR_ROLES = new Map([
+  ["access-path-centerline-candidate", { kind: "path", subtype: "planning-access-path", geometry: "line", priority: 100 }],
+  ["access-surface-candidate", { kind: "surface", subtype: "planning-access-surface", geometry: "area", priority: 95 }],
+  ["ride-centerline-candidate", { kind: "ride_track", subtype: "planning-ride-centerline", geometry: "line", priority: 92 }],
+  ["ride-footprint-candidate", { kind: "attraction", subtype: "planning-ride-footprint", geometry: "area", priority: 86 }],
+  ["building-footprint-candidate", { kind: "building", subtype: "planning-building-footprint", geometry: "area", priority: 90 }],
+  ["landscape-polygon-candidate", { kind: "vegetation", subtype: "planning-landscape-area", geometry: "area", priority: 72 }],
+  ["landscape-boundary-candidate", { kind: "barrier", subtype: "planning-landscape-boundary", geometry: "line", priority: 48 }],
+  ["drainage-or-contour-line-candidate", { kind: "water", subtype: "planning-drainage-line", geometry: "line", priority: 62 }],
+  ["lighting-area-candidate", { kind: "detail", subtype: "planning-lighting-area", geometry: "area", priority: 35 }],
+  ["lighting-layout-line-candidate", { kind: "detail", subtype: "planning-lighting-layout", geometry: "line", priority: 35 }]
+]);
