diff --git a/test/accuracy-source-upgrades.test.mjs b/test/accuracy-source-upgrades.test.mjs
new file mode 100644
index 0000000..2d68b13
--- /dev/null
+++ b/test/accuracy-source-upgrades.test.mjs
@@ -0,0 +1,79 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { parseArgs } from "../src/lib/args.mjs";
+import { enrichUniversalFidelity } from "../src/lib/fidelity.mjs";
+import { selectCoverageIdFromCapabilities } from "../src/lib/lidar.mjs";
+import { acquireSupplementalSources } from "../src/lib/supplemental-sources.mjs";
+
+test("EA VOM coverage is selected from WCS capabilities", () => {
+  const xml = `<?xml version="1.0"?><wcs:Capabilities xmlns:wcs="http://www.opengis.net/wcs/2.0"><wcs:Contents><wcs:CoverageSummary><wcs:CoverageId>unrelated__hillshade</wcs:CoverageId></wcs:CoverageSummary><wcs:CoverageSummary><wcs:CoverageId>vegetation-object-model__VOM_1m</wcs:CoverageId></wcs:CoverageSummary></wcs:Contents></wcs:Capabilities>`;
+  assert.equal(selectCoverageIdFromCapabilities(xml, /vegetation|vom/i, "vom"), "vegetation-object-model__VOM_1m");
+});
+
+test("EA VOM height takes precedence over DSM minus DTM for mapped trees", () => {
+  const map = {
+    features: [{ id: "tree", kind: "vegetation", subtype: "tree", tags: {}, localGeometry: { type: "Point", coordinates: [4, 5] } }],
+    pathTopology: null, pathGeometry: null, orthophoto: null, terrainDetails: null
+  };
+  enrichUniversalFidelity(map, {
+    elevation: {
+      sampleVegetationHeightLocal: () => 18.4,
+      samplePairLocal: () => ({ terrain: 100, surface: 109 })
+    }
+  }, { accuracyMode: "verified" });
+  assert.equal(map.features[0].fidelity.tree.heightM, 18.4);
+  assert.equal(map.features[0].fidelity.tree.heightSource, "ea-vom-canopy-height-at-mapped-tree");
+});
+
+test("CLI accepts EA VOM source controls", () => {
+  const parsed = parseArgs(["build", "--ea-vom", "--ea-vom-wcs-url", "https://example.test/vom/wcs", "--ea-vom-coverage-id", "vom-id"]);
+  assert.equal(parsed.options.eaVom, true);
+  assert.equal(parsed.options.eaVomWcsUrl, "https://example.test/vom/wcs");
+  assert.equal(parsed.options.eaVomCoverageId, "vom-id");
+});
+
+test("Planning Data requests never exceed the provider's 500 feature page limit", async () => {
+  const cacheDir = await mkdtemp(path.join(tmpdir(), "tpmap-planning-limit-"));
+  const originalFetch = globalThis.fetch;
+  const urls = [];
+  globalThis.fetch = async (url) => {
+    urls.push(String(url));
+    return new Response(JSON.stringify({ type: "FeatureCollection", features: [], links: [] }), {
+      status: 200, headers: { "content-type": "application/json" }
+    });
+  };
+  try {
+    await acquireSupplementalSources({ planningData: true, supplementalPageSize: 5000, noCache: true }, {
+      bbox: { south: 52.98, west: -1.90, north: 53.00, east: -1.86 },
+      center: { lat: 52.99, lon: -1.88 }, cacheDir, userAgent: "test"
+    });
+    const request = new URL(urls[0]);
+    assert.equal(request.searchParams.get("limit"), "500");
+  } finally {
+    globalThis.fetch = originalFetch;
+    await rm(cacheDir, { recursive: true, force: true });
+  }
+});
+
+test("Microsoft building adapter uses the current official index", async () => {
+  const cacheDir = await mkdtemp(path.join(tmpdir(), "tpmap-ms-index-"));
+  const originalFetch = globalThis.fetch;
+  const urls = [];
+  globalThis.fetch = async (url) => {
+    urls.push(String(url));
+    return new Response("Location,QuadKey,Size\n", { status: 200 });
+  };
+  try {
+    await acquireSupplementalSources({ microsoftBuildings: true, noCache: true }, {
+      bbox: { south: 52.98, west: -1.90, north: 53.00, east: -1.86 },
+      center: { lat: 52.99, lon: -1.88 }, cacheDir, userAgent: "test"
+    });
+    assert.equal(urls[0], "https://minedbuildings.z5.web.core.windows.net/global-buildings/dataset-links.csv");
+  } finally {
+    globalThis.fetch = originalFetch;
+    await rm(cacheDir, { recursive: true, force: true });
+  }
+});
