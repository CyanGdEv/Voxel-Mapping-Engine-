+async function acquireDiscoveredCoverage(options) {
+  const coverageId = options.coverageId || await discoverCoverageId(options);
+  return acquireCoverage({ ...options, coverageId });
+}
+
+async function discoverCoverageId({ endpoint, preferred, cacheDir, userAgent, noCache, role }) {
+  const url = new URL(endpoint);
+  url.searchParams.set("service", "WCS");
+  url.searchParams.set("version", "2.0.1");
+  url.searchParams.set("request", "GetCapabilities");
+  const cached = await cachedBinary({
+    cacheDir: path.join(cacheDir, "capabilities"),
+    key: url.toString(),
+    noCache,
+    extension: ".xml",
+    fetcher: () => fetchBinary(url, { headers: { "User-Agent": userAgent, Accept: "application/xml,text/xml;q=0.9,*/*;q=0.1" } }, { timeoutMs: 180_000, retries: 2 })
+  });
+  const bytes = cached.data || await readFile(cached.filename);
+  return selectCoverageIdFromCapabilities(bytes.toString("utf8"), preferred, role);
+}
+
+export function selectCoverageIdFromCapabilities(xml, preferred = null, role = "coverage") {
+  const ids = [...String(xml).matchAll(/<(?:[A-Za-z0-9_.-]+:)?CoverageId\b[^>]*>([^<]+)<\/(?:[A-Za-z0-9_.-]+:)?CoverageId>/g)]
+    .map((match) => decodeXml(match[1].trim()))
+    .filter(Boolean);
+  invariant(ids.length, `The ${role} WCS capabilities document contains no CoverageId`);
+  return preferred ? ids.find((id) => preferred.test(id)) || ids[0] : ids[0];
+}
+
+function decodeXml(value) {
+  return value.replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, '"').replace(/&apos;/g, "'");
+}
