diff --git a/src/cli.mjs b/src/cli.mjs
index 3f08639..7b5a09b 100644
--- a/src/cli.mjs
+++ b/src/cli.mjs
@@ -81,6 +81,13 @@ Public service consent
   --ea-vom-wcs-url URL              Replaceable Environment Agency VOM WCS
   --ea-vom-coverage-id ID           Explicit VOM coverage ID; otherwise discover from capabilities
   --ea-vom-bbox BBOX                Optional canopy-only bounds as south,west,north,east
+  --ea-tiled                         Split large EA WCS requests into cached validated tiles
+  --ea-tile-size-m 1000             Projected tile edge length
+  --ea-tile-concurrency 2           Maximum simultaneous EA tile requests
+  --ea-tile-min-coverage .85        Required valid-cell ratio for DTM/DSM tiles
+  --ea-tile-max-resolution-m 2      Reject unexpectedly coarse EA tile responses
+  --ea-tile-threshold-m 1500        Tile requests whose longest side exceeds this
+  --ea-tile-fallback-single         Controlled fallback to one WCS request if tiling fails
   --ea-index-wfs-url URL            Replaceable LiDAR survey-index WFS
   --cache DIRECTORY                 Response cache (default .tpmap-cache)
   --no-cache                        Refresh bounded source requests
