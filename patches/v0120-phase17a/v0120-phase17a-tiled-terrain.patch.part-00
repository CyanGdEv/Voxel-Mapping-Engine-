@@ -95,7 +97,8 @@ export function parseArgs(argv) {
 
 function normalize(options) {
   const numberKeys = [
-    "elevationSpacing", "scale", "maxAreaKm2", "maxCells", "minConfidence",
+    "elevationSpacing", "eaTileSizeM", "eaTileConcurrency", "eaTileMinCoverage",
+    "eaTileMaxResolutionM", "eaTileThresholdM", "scale", "maxAreaKm2", "maxCells", "minConfidence",
     "opsPerYield", "buildDepth", "baseY", "worldMargin", "maxWorldChunks",
     "chunkVersion", "blockDataVersion", "seed", "rideCorridorM", "rideSampleM",
     "rideInterpolationGapM", "pointCloudSkip", "maxPointCloudMb",
@@ -164,6 +167,17 @@ function normalize(options) {
     (options.microsoftBuildingsMinConfidence < 0 || options.microsoftBuildingsMinConfidence > 1)) {
     throw new UserError("--microsoft-buildings-min-confidence must be between 0 and 1");
   }
+  for (const [key, minimum, maximum] of [
+    ["eaTileSizeM", 100, 5000], ["eaTileConcurrency", 1, 8],
+    ["eaTileMinCoverage", 0, 1], ["eaTileMaxResolutionM", 0.25, 20],
+    ["eaTileThresholdM", 100, 20000]
+  ]) {
+    if (options[key] === undefined) continue;
+    if (options[key] < minimum || options[key] > maximum ||
+      (key === "eaTileConcurrency" && !Number.isInteger(options[key]))) {
+      throw new UserError(`--${toKebab(key)} must be ${key === "eaTileConcurrency" ? "an integer " : ""}between ${minimum} and ${maximum}`);
+    }
+  }
