  PHASE30B_LIBRARY_TRANSFORM="$ROOT/patches/v0120-phase30b/material-library-extension-transform.mjs"
  PHASE30B_LIBRARY_TRANSFORM_SHA="8aac7e1c21c33475c486a1224f18ceda5b9dc4eea2df3243a2486b144444a92a"
  PHASE30B_LIBRARY_V2_TRANSFORM="$ROOT/patches/v0120-phase30b/material-library-v2-transform.mjs"
  PHASE30B_LIBRARY_V2_TRANSFORM_SHA="ade43a7ff9adec7ff731094611f53f07052d884d68a794087bb9b899558b25ef"
  PHASE30B_LIBRARY_V2_FINALIZE="$ROOT/patches/v0120-phase30b/material-library-v2-finalize.mjs"
  PHASE30B_LIBRARY_V2_FINALIZE_SHA="7c761a049289f284204a738192cea8c3c8336fa67ed2ab60a6f20529cd9004a6"
  [[ -f "$PHASE30B_LIBRARY_TRANSFORM" && -f "$PHASE30B_LIBRARY_V2_TRANSFORM" && -f "$PHASE30B_LIBRARY_V2_FINALIZE" ]] || {
    echo "Missing Phase 30B extended material library transform." | tee "$DIAG/phase30b-material-library-error.txt" >&2
    exit 2
  }
  phase30b_library_actual_sha="$(sha256sum "$PHASE30B_LIBRARY_TRANSFORM" | cut -d' ' -f1)"
  phase30b_library_v2_actual_sha="$(sha256sum "$PHASE30B_LIBRARY_V2_TRANSFORM" | cut -d' ' -f1)"
  phase30b_library_v2_finalize_actual_sha="$(sha256sum "$PHASE30B_LIBRARY_V2_FINALIZE" | cut -d' ' -f1)"
  printf 'material_library_transform_expected=%s\nmaterial_library_transform_actual=%s\nmaterial_library_v2_transform_expected=%s\nmaterial_library_v2_transform_actual=%s\nmaterial_library_v2_finalize_expected=%s\nmaterial_library_v2_finalize_actual=%s\n' \
    "$PHASE30B_LIBRARY_TRANSFORM_SHA" "$phase30b_library_actual_sha" \
    "$PHASE30B_LIBRARY_V2_TRANSFORM_SHA" "$phase30b_library_v2_actual_sha" \
    "$PHASE30B_LIBRARY_V2_FINALIZE_SHA" "$phase30b_library_v2_finalize_actual_sha" \
    | tee "$DIAG/phase30b-material-library-checksum.txt"
  [[ "$phase30b_library_actual_sha" == "$PHASE30B_LIBRARY_TRANSFORM_SHA" ]] || {
    echo "Phase 30B extended material library checksum mismatch." | tee "$DIAG/phase30b-material-library-error.txt" >&2
    exit 2
  }
  [[ "$phase30b_library_v2_actual_sha" == "$PHASE30B_LIBRARY_V2_TRANSFORM_SHA" ]] || {
    echo "Phase 30B material library V2 checksum mismatch." | tee "$DIAG/phase30b-material-library-error.txt" >&2
    exit 2
  }
  [[ "$phase30b_library_v2_finalize_actual_sha" == "$PHASE30B_LIBRARY_V2_FINALIZE_SHA" ]] || {
    echo "Phase 30B material library V2 finalize checksum mismatch." | tee "$DIAG/phase30b-material-library-error.txt" >&2
    exit 2
  }

  node --check "$PHASE30B_LIBRARY_V2_TRANSFORM"
  node --check "$PHASE30B_LIBRARY_V2_FINALIZE"
  node "$PHASE30B_LIBRARY_TRANSFORM" --root "$GEN" \
    2>&1 | tee "$DIAG/phase30b-material-library-transform.log"
  node "$PHASE30B_LIBRARY_V2_TRANSFORM" --root "$GEN" \
    2>&1 | tee "$DIAG/phase30b-material-library-v2-transform.log"
  node "$PHASE30B_LIBRARY_V2_FINALIZE" --root "$GEN" \
    2>&1 | tee "$DIAG/phase30b-material-library-v2-finalize.log"
  node --check "$GEN/src/lib/fidelity.mjs"
  node --check "$GEN/src/lib/mcworld.mjs"

  # Validate the contracts owned by the extended material library. V2's own
  # suite keeps exact palettes/weights for every superseding recipe; the V1
  # suite keeps exact assertions only for recipes that V2 did not supersede.
  # Direct-world palette validation still runs after the later compatibility
  # synchronizer at the final prepared-generator gate.
  if ! (
    cd "$GEN"
    node --test \
      test/material-pattern-recipes.test.mjs \
      test/material-pattern-library.test.mjs \
      test/material-pattern-library-v2.test.mjs
  ) > "$DIAG/phase30b-material-library-tests.log" 2>&1; then
    cat "$DIAG/phase30b-material-library-tests.log" >&2
    echo "Phase 30B extended material-library regression failed." | tee "$DIAG/phase30b-material-library-error.txt" >&2
    exit 2
  fi
  cat "$DIAG/phase30b-material-library-tests.log"

  printf '%s\n' \
    'extended_material_library=enabled' \
    'materials=weathered-asphalt,fresh-asphalt,light-asphalt,red-tarmac,resin-bound-beige,resin-bound-grey,concrete,old-concrete,grey-block-paving,red-block-paving,buff-paving,cobblestone,old-stone-paving,gravel,hoggin,dirt-trail,woodland-floor,mulch,healthy-lawn,worn-grass,boardwalk,weathered-timber,sand,natural-rock,dark-rockwork,artificial-rockwork,old-brick-wall,sandstone-wall,industrial-service-paving' \
    'material_library_v2=41-deterministic-recipes' \
    'material_library_v2_additions=old-cracked-asphalt,dark-concrete,weathered-concrete,dark-block-paving,weathered-stone,dark-stone,light-stone,mossy-stone,weathered-rock,muddy-ground,planting-bed,dark-timber,queue-floor,service-yard,old-brickwork,industrial-metal-floor,slate-roof,weathered-roof' \
    'core_materials=asphalt-60-40,brick-60-30-10,stone-55-5-20-15-5' \
    'recipe_selection=raw-material-label-v2-first-then-v1-then-canonical-material' \
    'sandstone_material_alias=canonical-self-alias-enabled' \
    'pattern_scales=material-specific-deterministic' \
    'palette_policy=exact-weighted-recipes-not-re-randomised-by-world-palette' \
    'planning_qa=planning-derived geometry remains minecraft:pink_wool while provenance QA is active' \
    > "$DIAG/phase30b-material-library-policy.txt"
