async function install(root){root=path.resolve(root);const f={g:path.join(root,'src/lib/planning-georeference.mjs'),a:path.join(root,'src/lib/planning-auto-registration.mjs'),p:path.join(root,'src/tools/planning_auto_register.py'),s:path.join(root,'src/lib/source-fusion.mjs')};await writeFile(f.g,transformPlanningGeoreference(await readFile(f.g,'utf8')));await writeFile(f.a,transformPlanningAutoRegistration(await readFile(f.a,'utf8')));await writeFile(f.p,transformPlanningAutoRegisterPython(await readFile(f.p,'utf8')));await writeFile(f.s,transformSourceFusion(await readFile(f.s,'utf8')));await mkdir(path.join(root,'test'),{recursive:true});await writeFile(path.join(root,'test/planning-area-authority.test.mjs'),testSource);await validate(root)}
if(opt.selfTest){const root=process.env.TPMAP_INSTALLER_SELFTEST_SOURCE;if(root){const g=transformPlanningGeoreference(await readFile(path.join(root,'src/lib/planning-georeference.mjs'),'utf8')),a=transformPlanningAutoRegistration(await readFile(path.join(root,'src/lib/planning-auto-registration.mjs'),'utf8')),py=transformPlanningAutoRegisterPython(await readFile(path.join(root,'src/tools/planning_auto_register.py'),'utf8')),sf=transformSourceFusion(await readFile(path.join(root,'src/lib/source-fusion.mjs'),'utf8'));if(!g.includes(MARKER)||!a.includes('selectedCandidates')||!py.includes('ranked_registration_alternatives')||!sf.includes('planning_surface_authority'))throw new Error('self-test failed')}console.log('planning area authority installer self-test passed')}
else{if(!opt.generator)throw new Error('--generator required');if(opt.validateOnly)await validate(path.resolve(opt.generator));else await install(opt.generator);console.log(`${opt.validateOnly?'validated':'installed'} planning area authority`)}
