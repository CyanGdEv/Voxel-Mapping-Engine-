
    PALETTE_COMPAT_TRANSFORM="$ROOT/patches/v0120-phase30/bedrock-palette-compatibility.mjs"
    [[ -f "$PALETTE_COMPAT_TRANSFORM" ]] || {
      echo "Missing Bedrock palette compatibility transform." | tee "$DIAG/palette-compatibility-error.txt" >&2
      exit 2
    }
    node "$PALETTE_COMPAT_TRANSFORM" --self-test \
      2>&1 | tee "$DIAG/palette-compatibility-self-test.log"
    node "$PALETTE_COMPAT_TRANSFORM" \
      --generator "$GEN" \
      2>&1 | tee "$DIAG/palette-compatibility-apply.log"
    node --check "$GEN/src/lib/mcworld.mjs"
    if ! grep -q 'PHASE30_SCENERY_BLOCK_LIBRARY_V2' "$GEN/src/lib/mcworld.mjs"; then
      echo "Phase 30 Bedrock block-library synchronization marker is missing." | tee "$DIAG/palette-compatibility-error.txt" >&2
      exit 2
    fi
