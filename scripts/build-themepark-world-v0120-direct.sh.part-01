  *)
    echo "Unknown accuracy profile: $ACCURACY" >&2
    exit 2
    ;;
esac

SAFE_NAME="$(printf '%s' "$PARK_NAME" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')"
printf 'park=%s\nbbox=%s\naccuracy=%s\nsource=v0.12.0-direct-archive\n' \
  "$PARK_NAME" "$BBOX" "$ACCURACY_MODE" | tee "$DIAG/parameters.txt"

[[ -f "$SOURCE_ZIP" ]] || {
  echo "Missing checksum-locked ThemePark Map v0.12.0 source archive." | tee "$DIAG/source-error.txt" >&2
  exit 2
}

ACTUAL_SOURCE_SHA="$(sha256sum "$SOURCE_ZIP" | cut -d' ' -f1)"
printf 'archive_expected=%s\narchive_actual=%s\narchive=%s\n' \
  "$EXPECTED_SOURCE_SHA" "$ACTUAL_SOURCE_SHA" "$(basename "$SOURCE_ZIP")" \
  | tee "$DIAG/source-checksum.txt"
[[ "$ACTUAL_SOURCE_SHA" == "$EXPECTED_SOURCE_SHA" ]] || {
  echo "v0.12.0 source archive checksum mismatch." | tee -a "$DIAG/source-error.txt" >&2
  exit 2
}

unzip -t "$SOURCE_ZIP" | tee "$DIAG/source-archive-validation.log"
rm -rf "$GEN"
mkdir -p "$GEN"
unzip -q "$SOURCE_ZIP" -d "$GEN"

FIDELITY_FILE="$GEN/src/lib/fidelity.mjs"
python3 - "$FIDELITY_FILE" <<'PY' | tee "$DIAG/fidelity-polygon-area-hotfix.log"
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
statement = 'import { polygonArea } from "./geo.mjs";'
if statement not in text:
    path.write_text(statement + "\n" + text, encoding="utf-8")
    print("applied missing polygonArea import")
else:
    print("polygonArea import already present")
PY

node --input-type=module - "$FIDELITY_FILE" <<'NODE' 2>&1 | tee "$DIAG/fidelity-tree-polygon-smoke.log"
import { pathToFileURL } from 'node:url';
const { enrichUniversalFidelity } = await import(pathToFileURL(process.argv[2]).href);
const map = {
  features: [{
    id: 'ci-tree-polygon-smoke',
    kind: 'vegetation',
    subtype: 'lone_tree_canopy',
    tags: {},
    localGeometry: {
      type: 'Polygon',
      coordinates: [[[0, 0], [4, 0], [4, 4], [0, 4], [0, 0]]]
    }
  }],
  pathTopology: null,
  pathGeometry: null,
  orthophoto: null,
  terrainDetails: null
};
enrichUniversalFidelity(map, {}, { accuracyMode: 'plausible' });
const tree = map.features[0].fidelity?.tree;
if (!tree || tree.modelClass !== 'tree' || tree.crownDiameterM !== 4.5) {
  throw new Error(`Tree polygon fidelity smoke test failed: ${JSON.stringify(tree)}`);
}
console.log(`tree polygon fidelity passed crownDiameterM=${tree.crownDiameterM}`);
NODE

MCWORLD_FILE="$GEN/src/lib/mcworld.mjs"
python3 - "$MCWORLD_FILE" <<'PY' | tee "$DIAG/mcworld-bounds-hotfix.log"
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")

old_bounds = '''function worldChunkBounds(compilation, margin) {
  const bounds = compilation.meta.bounds;
  const operationX = compilation.chunks.map((chunk) => chunk.x);
  const operationZ = compilation.chunks.map((chunk) => chunk.z);
  return {
    minChunkX: Math.min(floorDiv(bounds.minX - margin, 16), ...operationX),
    minChunkZ: Math.min(floorDiv(bounds.minZ - margin, 16), ...operationZ),
    maxChunkX: Math.max(floorDiv(bounds.maxX + margin, 16), ...operationX),
    maxChunkZ: Math.max(floorDiv(bounds.maxZ + margin, 16), ...operationZ)
  };
}'''

new_bounds = '''function worldChunkBounds(compilation, margin) {
  const bounds = compilation.meta.bounds;
  return {
    minChunkX: floorDiv(bounds.minX - margin, 16),
    minChunkZ: floorDiv(bounds.minZ - margin, 16),
    maxChunkX: floorDiv(bounds.maxX + margin, 16),
    maxChunkZ: floorDiv(bounds.maxZ + margin, 16)
  };
}'''

old_operations = '  const operationChunks = new Map(compilation.chunks.map((chunk) => [`${chunk.x},${chunk.z}`, chunk]));'

new_operations = '''  const inBoundsOperationChunks = compilation.chunks.filter((chunk) =>
    chunk.x >= bounds.minChunkX && chunk.x <= bounds.maxChunkX &&
    chunk.z >= bounds.minChunkZ && chunk.z <= bounds.maxChunkZ
  );
  const ignoredOperationChunks = compilation.chunks.length - inBoundsOperationChunks.length;
  if (ignoredOperationChunks) {
    progress(`Ignoring ${ignoredOperationChunks.toLocaleString()} operation chunks outside the verified raster bounds`);
  }
  const operationChunks = new Map(
    inBoundsOperationChunks.map((chunk) => [`${chunk.x},${chunk.z}`, chunk])
  );'''

changed = False
if new_bounds not in text:
    if old_bounds not in text:
        raise SystemExit("Could not locate worldChunkBounds implementation")
    text = text.replace(old_bounds, new_bounds, 1)
    changed = True

if new_operations not in text:
    if old_operations not in text:
        raise SystemExit("Could not locate operation chunk map")
    text = text.replace(old_operations, new_operations, 1)
    changed = True

path.write_text(text, encoding="utf-8")
print("applied authoritative raster chunk bounds" if changed else "authoritative raster chunk bounds already present")
PY

LIDAR_FILE="$GEN/src/lib/lidar.mjs"
python3 - "$LIDAR_FILE" <<'PYLIDAR' | tee "$DIAG/lidar-large-context-hotfix.log"
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
old = '{ timeoutMs: 240_000, retries: 2 }'
new = '{ timeoutMs: 1_200_000, retries: 3 }'
if old in text:
    text = text.replace(old, new, 1)
    path.write_text(text, encoding="utf-8")
    print("extended Environment Agency WCS timeout for large terrain contexts")
elif new in text:
    print("large-context WCS timeout already present")
else:
    raise SystemExit("Could not locate Environment Agency WCS timeout policy")
PYLIDAR

find "$GEN/src" "$GEN/scripts" "$GEN/test" -type f -name '*.mjs' -print0 \
  | xargs -0 -n1 node --check 2>&1 | tee "$DIAG/source-syntax-check.log"

node --input-type=module - "$GEN/package.json" <<'NODE' 2>&1 | tee "$DIAG/version-check.log"
import { readFileSync } from 'node:fs';
const file = process.argv[2];
const pkg = JSON.parse(readFileSync(file, 'utf8'));
if (pkg.version !== '0.12.0') throw new Error(`Expected v0.12.0, got ${pkg.version}`);
console.log(`ThemePark Map source version ${pkg.version}`);
NODE

(
  cd "$GEN"
  npm ci --no-audit --no-fund 2>&1 | tee "$DIAG/npm-ci.log"
  node --input-type=module - <<'NODE' 2>&1 | tee "$DIAG/mcworld-bounds-smoke.log"
import { mkdtemp, rm } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import path from 'node:path';
import { buildBedrockWorld } from './src/lib/mcworld.mjs';

const outputDir = await mkdtemp(path.join(tmpdir(), 'tpmap-mcworld-bounds-'));
try {
  const compilation = {
    meta: {
      bounds: { minX: 0, minZ: 0, maxX: 15, maxZ: 15 },
      spawnLocal: { x: 0, y: 0, z: 0 },
      buildingMode: 'markers'
    },
    palette: ['minecraft:grass_block'],
    signs: [],
    stats: {},
    chunks: [
      { x: 0, z: 0, o: [[1, 0, 0, 0, 0, 0, 0, 0]] },
      { x: 1000, z: 1000, o: [[4, 16000, 1, 16000, 16000, 1, 16000, 0]] }
    ]
  };
  const result = await buildBedrockWorld({
    parkName: 'CI bounds smoke',
    slug: 'ci-bounds-smoke',
    compilation,
    outputDir,
    options: {
      palette: 'clean',
      worldMargin: 0,
      maxWorldChunks: 4,
      baseY: 64,
      seed: 1
    }
  });
  if (result.chunkCount !== 1) {
    throw new Error(`Expected one authoritative raster chunk, got ${result.chunkCount}`);
  }
  console.log(`mcworld bounds passed chunkCount=${result.chunkCount}`);
} finally {
  await rm(outputDir, { recursive: true, force: true });
}
NODE
