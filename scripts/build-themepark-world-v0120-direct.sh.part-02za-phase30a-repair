
  # Phase 30A's historical unified patch can partially apply against the modern
  # Phase 29/30 prepared source. Repair the intended authority + pink-QA policy
  # deterministically before Phase 30B builds on it.
  PHASE30A_INSTALLER="$ROOT/scripts/install-phase30a-authority.mjs"
  [[ -f "$PHASE30A_INSTALLER" ]] || {
    echo "Missing deterministic Phase 30A authority installer." | tee "$DIAG/phase30a-repair-error.txt" >&2
    exit 2
  }
  "$TPMAP_NODE_BIN" "$PHASE30A_INSTALLER" --self-test \
    2>&1 | tee "$DIAG/phase30a-repair-self-test.log"
  "$TPMAP_NODE_BIN" "$PHASE30A_INSTALLER" --generator "$GEN" \
    2>&1 | tee "$DIAG/phase30a-repair-apply.log"
  "$TPMAP_NODE_BIN" --check "$GEN/src/lib/planning-vector-fusion.mjs"
  "$TPMAP_NODE_BIN" --check "$GEN/src/lib/source-fusion.mjs"
  "$TPMAP_NODE_BIN" --check "$GEN/src/lib/raster.mjs"
  "$TPMAP_NODE_BIN" "$PHASE30A_INSTALLER" --generator "$GEN" --validate-only \
    2>&1 | tee "$DIAG/phase30a-repair-validation.log"

  # Reject files created by the superseded best-effort patch are no longer
  # authoritative once the deterministic installer validates the final source.
  rm -f \
    "$GEN/src/lib/planning-vector-fusion.mjs.rej" \
    "$GEN/src/lib/raster.mjs.rej" \
    "$GEN/src/lib/source-fusion.mjs.rej"
