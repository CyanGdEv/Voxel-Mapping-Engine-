  # Phase 34 — first graph-to-world cutover. Apply only verified cutting/tunnel
  # mask cells to the existing native Bedrock compilation as phase-7 air runs.
  PHASE34_EXCAVATION_COMPILER_INSTALLER="$ROOT/patches/v0120-phase34/install-ride-excavation-compiler.mjs"
  PHASE34_EXCAVATION_COMPILER_LOG="$DIAG/phase34-ride-excavation-compiler.log"

  "$TPMAP_NODE_BIN" "$PHASE34_EXCAVATION_COMPILER_INSTALLER" --self-test 2>&1 | tee "$PHASE34_EXCAVATION_COMPILER_LOG"
  "$TPMAP_NODE_BIN" "$PHASE34_EXCAVATION_COMPILER_INSTALLER" --generator "$GEN" 2>&1 | tee -a "$PHASE34_EXCAVATION_COMPILER_LOG"
  "$TPMAP_NODE_BIN" "$PHASE34_EXCAVATION_COMPILER_INSTALLER" --generator "$GEN" --validate-only 2>&1 | tee -a "$PHASE34_EXCAVATION_COMPILER_LOG"

  "$TPMAP_NODE_BIN" --check "$GEN/src/lib/ride-excavation-compiler.mjs"
  "$TPMAP_NODE_BIN" --check "$GEN/src/lib/pipeline.mjs"
  (
    cd "$GEN"
    "$TPMAP_NODE_BIN" --test test/ride-excavation-compiler.test.mjs 2>&1 | tee -a "$PHASE34_EXCAVATION_COMPILER_LOG"
  )

  printf '%s\n' \
    'phase34_ride_excavation_compiler=enabled' \
    'input=verified-phase34-excavation-mask-only' \
    'writer=native-chunked-bedrock-operation-compiler' \
    'operation=phase7-minecraft-air' \
    'vertical_conversion=absolute-planning-elevation-minus-compiler-datum' \
    'empty_mask=exact-compilation-no-op' \
    'unsupported_schema=fail-closed-before-mutation' \
    'outside_authorised_voxels=no-writes' \
    'portal_support_track_order=phase8-phase9-preserved' \
    > "$DIAG/phase34-ride-excavation-compiler-policy.txt"
