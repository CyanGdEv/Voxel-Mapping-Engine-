
    # Final preparation gate. This fragment intentionally sorts after Phase 30C/
    # 30D and every current Phase 30 transform. The previous guard ran before
    # those transforms and rejected a valid intermediate generator.
    local preflight_log="$DIAG/prepared-generator-integrity.log"
    local preparation_failed=false
    : > "$preflight_log"

    require_marker() {
      local marker="$1" file="$2" label_text="$3"
      if [[ ! -f "$file" ]] || ! grep -q "$marker" "$file"; then
        echo "PREP_FAIL $label_text marker=$marker file=$file" | tee -a "$preflight_log" >&2
        preparation_failed=true
      else
        echo "PREP_OK $label_text" >> "$preflight_log"
      fi
    }

    if ! grep -q 'TPMAP_SURFACE_MATERIAL_LIBRARY_V1' "$GEN/src/lib/fidelity.mjs" 2>/dev/null \
       && ! grep -q 'TPMAP_SURFACE_MATERIAL_LIBRARY_V1' "$GEN/src/lib/raster.mjs" 2>/dev/null; then
      echo "PREP_FAIL surface material sampler integration marker missing" | tee -a "$preflight_log" >&2
      preparation_failed=true
    else
      echo "PREP_OK surface material sampler integration" >> "$preflight_log"
    fi
    require_marker 'PARK_SCENERY_FIDELITY_MARKER' "$GEN/src/lib/park-scenery-fidelity.mjs" 'park scenery library'
    require_marker 'PARK_LANDSCAPING_FIDELITY_MARKER' "$GEN/src/lib/park-landscaping-fidelity.mjs" 'park landscaping library'
    require_marker 'PHASE30B_SEMANTIC_SITE_PLANS' "$GEN/src/lib/planning-vectorize.mjs" 'Phase 30B site semantics'
    require_marker 'PHASE30B_EXTENDED_BLOCK_LIBRARY_V1' "$GEN/src/lib/mcworld.mjs" 'Phase 30B material writer library'
    require_marker 'PHASE30_SCENERY_BLOCK_LIBRARY_V2' "$GEN/src/lib/mcworld.mjs" 'Phase 30 scenery block writer library'

    # Phase 30D is optional only on historical branches. On current production
    # main it must be present before the final integrity gate runs.
    if [[ -f "$ROOT/patches/v0120-phase30d/raster-planning-vectorization.mjs" ]]; then
      require_marker 'PHASE30D_RASTER_PLANNING_GEOMETRY' "$GEN/src/lib/planning-vectorize.mjs" 'Phase 30D raster planning vectorization'
      require_marker 'PHASE30D_RASTER_PLANNING_GEOMETRY' "$GEN/src/lib/planning-georeference.mjs" 'Phase 30D raster planning georeference'
    fi

    for module in \
      "$GEN/src/lib/fidelity.mjs" \
      "$GEN/src/lib/raster.mjs" \
      "$GEN/src/lib/mcworld.mjs" \
      "$GEN/src/lib/planning-vectorize.mjs" \
      "$GEN/src/lib/planning-vector-fusion.mjs" \
      "$GEN/src/lib/source-fusion.mjs"; do
      if ! "$TPMAP_NODE_BIN" --check "$module" >> "$preflight_log" 2>&1; then
        echo "PREP_FAIL syntax $(basename "$module")" | tee -a "$preflight_log" >&2
        preparation_failed=true
      fi
    done

    # Validate the intended Phase 30A policy directly instead of re-running old
    # archived tests whose expectations predate Phase 30A's authority change.
    if ! "$TPMAP_NODE_BIN" "$ROOT/scripts/install-phase30a-authority.mjs" \
      --generator "$GEN" --validate-only >> "$preflight_log" 2>&1; then
      echo "PREP_FAIL Phase 30A deterministic authority validation" | tee -a "$preflight_log" >&2
      preparation_failed=true
    else
      echo "PREP_OK Phase 30A deterministic authority validation" >> "$preflight_log"
    fi

    if ! (
      cd "$GEN"
      "$TPMAP_NODE_BIN" --input-type=module - <<'NODE'
import assert from 'node:assert/strict';
import { __test as fusionTest } from './src/lib/planning-vector-fusion.mjs';
import { __test as vectorTest } from './src/lib/planning-vectorize.mjs';
import { compileMap } from './src/lib/raster.mjs';
import { deriveSurfaceStyle, blockForSurfaceStyle } from './src/lib/fidelity.mjs';

const approved = fusionTest.planningState('approved', 'approved', 'gated');
assert.equal(approved.allowed, true);
assert.equal(approved.requiresExistingTarget, false);
assert.equal(approved.gapFillAllowed, true);
const review = fusionTest.planningState('approved', 'approved', 'review');
assert.equal(review.gapFillAllowed, false);

const pathSemantic = vectorTest.classifyPlanningSemanticLabel('3m wide resin bound pedestrian path');
assert.equal(pathSemantic.className, 'path');
assert.equal(pathSemantic.material, 'resin');
assert.equal(pathSemantic.widthM, 3);
const pathRole = vectorTest.semanticGeometryRole(pathSemantic, false);
assert.equal(pathRole.role, 'site-path-centerline-candidate');
assert.equal(pathRole.tags.highway, 'footway');

function planningFeature(id, kind, geometry, extra = {}) {
  return {
    id, name: id, kind, subtype: `planning-${kind}`,
    tags: { planning_qa: true, planning_authoritative: true, planning_reference: 'APP/QA/1', ...(extra.tags || {}) },
    localGeometry: geometry,
    vertical: { heightM: null, elevationM: null, explicit: false, ...(extra.vertical || {}) },
    verification: { plan: 'planning-authority-override', vertical: 'unknown' },
    source: { provider: 'Planning authority', dataset: 'planning-drawing-vector' },
    surfaceStyle: { primaryBlock: 'minecraft:stone', secondaryBlock: 'minecraft:stone', pattern: 'solid', appearanceStatus: 'source' }
  };
}
const map = {
  boundary: { localGeometry: { type: 'Polygon', coordinates: [[[0,0],[20,0],[20,20],[0,20],[0,0]]] } },
  features: [
    planningFeature('plan:path','path',{type:'LineString',coordinates:[[2,2],[18,2]]},{tags:{highway:'footway',width:'3'}}),
    planningFeature('plan:building','building',{type:'Polygon',coordinates:[[[4,5],[9,5],[9,10],[4,10],[4,5]]]}),
    planningFeature('plan:ride','ride_track',{type:'LineString',coordinates:[[2,14],[18,14]]}),
    planningFeature('plan:wall','barrier',{type:'LineString',coordinates:[[2,18],[18,18]]},{tags:{barrier:'wall'}})
  ],
  topology:{}, semantics:{}, fidelity:null, orthophoto:null, pathTopology:null, pathGeometry:null,
  rideProfiles:null, terrainDetails:null
};
const compilation = compileMap({
  parkName:'Planning QA', map,
  sources:{center:{lat:0,lon:0}, elevation:{provider:'synthetic',minM:0,points:[],sampleLocal:()=>0}},
  accuracy:{score:1,grade:'A',exact3d:false},
  options:{maxCells:10_000,buildings:'markers',noRideInfoSigns:true,accuracyMode:'verified'}
});
const pink = compilation.palette.indexOf('minecraft:pink_wool');
assert.ok(pink >= 0);
assert.ok(compilation.chunks.flatMap((chunk)=>chunk.o).filter((op)=>op[7]===pink).length >= 4);

const materialFeature={id:'m:weathered',kind:'path',tags:{surface:'weathered_asphalt'},localGeometry:{type:'LineString',coordinates:[[0,0],[100,0]]},source:{provider:'preflight'}};
const style=deriveSurfaceStyle(materialFeature,{accuracyMode:'plausible'});
assert.equal(style.exactMaterialPalette,true);
assert.ok(style.paletteBlocks.length >= 4);
const a=Array.from({length:128},(_,i)=>blockForSurfaceStyle(style,i%16,Math.floor(i/16),417));
const b=Array.from({length:128},(_,i)=>blockForSurfaceStyle(style,i%16,Math.floor(i/16),417));
assert.deepEqual(a,b);
console.log('Phase 30 current-semantics integration preflight passed');
NODE
    ) >> "$preflight_log" 2>&1; then
      echo "PREP_FAIL Phase 30 current-semantics integration probe" | tee -a "$preflight_log" >&2
      preparation_failed=true
    else
      echo "PREP_OK Phase 30 current-semantics integration probe" >> "$preflight_log"
    fi

    if find "$GEN" -type f -name '*.rej' -print -quit | grep -q .; then
      echo "PREP_FAIL patch reject files remain after deterministic repair" | tee -a "$preflight_log" >&2
      find "$GEN" -type f -name '*.rej' -print >> "$preflight_log"
      preparation_failed=true
    fi

    if [[ "$preparation_failed" == "true" ]]; then
      echo "Prepared generator failed final integrity preflight; refusing expensive world compilation." | tee -a "$preflight_log" >&2
      touch "$DIAG/deterministic-build-failure.marker"
      return 64
    fi

    TPMAP_ATTEMPT_PREPARED=true
  fi

  if [[ -f "$DIAG/deterministic-build-failure.marker" ]]; then
    echo "strategy=$label skipped: prior source-independent build failure makes source fallback useless" | tee "$log"
    return 64
  fi
  if [[ -f "$DIAG/world-runtime-budget-exhausted.marker" ]]; then
    echo "strategy=$label skipped: world-generation runtime budget already exhausted" | tee "$log"
    return 65
  fi

  # Wrap only the actual generator build. This keeps the existing runner intact
  # while adding one wall-clock budget and source-independent failure detection.
  node() {
    if [[ "${1:-}" == "src/cli.mjs" && "${2:-}" == "build" ]]; then
      local elapsed=$((SECONDS - TPMAP_WORLD_RUN_STARTED_AT))
      local remaining=$((TPMAP_WORLD_RUN_BUDGET_SECONDS - elapsed))
      local classifier_log="$DIAG/.build-failure-classifier-${label}.log"
      if (( remaining < 60 )); then
        printf 'World generation budget exhausted before strategy %s (elapsed=%ss budget=%ss).\n' \
          "$label" "$elapsed" "$TPMAP_WORLD_RUN_BUDGET_SECONDS" | tee "$classifier_log" >&2
        touch "$DIAG/world-runtime-budget-exhausted.marker"
        return 124
      fi

      set +e
      timeout --signal=TERM --kill-after=20s "${remaining}s" "$TPMAP_NODE_BIN" "$@" 2>&1 | tee "$classifier_log"
      local status=${PIPESTATUS[0]}
      set -e

      if [[ "$status" -eq 124 || "$status" -eq 137 ]]; then
        echo "World generator exceeded the bounded runtime budget." | tee -a "$classifier_log" >&2
        touch "$DIAG/world-runtime-budget-exhausted.marker"
      elif [[ "$status" -ne 0 ]] && grep -Eqi \
        'unsupported Bedrock block identifier|direct-world palette contains an unsupported|ReferenceError:|SyntaxError:|ERR_MODULE_NOT_FOUND|checksum mismatch|content hash mismatch|changed unexpectedly' \
        "$classifier_log"; then
        echo "Source-independent generator failure detected; alternate terrain/Overpass strategies will not rebuild the park." | tee -a "$classifier_log" >&2
        touch "$DIAG/deterministic-build-failure.marker"
      fi
      rm -f "$classifier_log.tmp" 2>/dev/null || true
      return "$status"
    fi
    "$TPMAP_NODE_BIN" "$@"
  }
