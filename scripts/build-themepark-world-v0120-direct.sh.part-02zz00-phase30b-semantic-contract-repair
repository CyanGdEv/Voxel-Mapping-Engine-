  # Phase 30B semantic contract postcondition.
  #
  # The preceding Phase 30B preparation stage is the single mutation/recovery
  # authority: it checksum-validates the archived patch, applies it only when
  # the executable behavior suite is incomplete, and re-runs the suite before
  # continuing. Do not replay that historical patch here. Later prepared-source
  # transforms legitimately change implementation anchors while preserving the
  # semantic contract, so anchor-grep-driven repair can corrupt an already-green
  # generator and leave .rej files behind.
  #
  # This stage therefore validates the externally observable contract only. It
  # retains the stale/empty-test protection that originally motivated this
  # fragment, but it never mutates the prepared generator.
  phase30b_semantic_contract_probe() {
    [[ -f "$GEN/src/lib/planning-vectorize.mjs" ]] || return 1
    [[ -f "$GEN/src/lib/planning-vector-fusion.mjs" ]] || return 1
    [[ -f "$GEN/test/planning-site-semantics.test.mjs" ]] || return 1

    # An empty historical semantic test file must never satisfy the contract.
    # The preceding recovery stage and this postcondition both exercise the real
    # extraction/fusion behavior, so source-token greps are intentionally not an
    # authority here: later prepared-generator transforms may rename/restructure
    # internals without changing the externally observable planning semantics.
    local semantic_test_count
    semantic_test_count="$(grep -Ec '(^|[^A-Za-z])test\(' "$GEN/test/planning-site-semantics.test.mjs" || true)"
    [[ "$semantic_test_count" -ge 3 ]] || return 1

    (
      cd "$GEN"
      node --test \
        test/planning-vectorize.test.mjs \
        test/planning-vector-fusion.test.mjs \
        test/planning-site-semantics.test.mjs \
        test/planning-pink-qa.test.mjs
    ) > "$DIAG/phase30b-semantic-contract-probe.log" 2>&1
  }

  if ! phase30b_semantic_contract_probe; then
    if [[ -f "$DIAG/phase30b-semantic-contract-probe.log" ]]; then
      cat "$DIAG/phase30b-semantic-contract-probe.log" >&2
    fi
    echo "Phase 30B semantic contract postcondition failed after the authoritative recovery stage." \
      | tee "$DIAG/phase30b-semantic-contract-failure.log" >&2
    exit 2
  fi

  if find "$GEN/src/lib" -maxdepth 1 -type f -name 'planning-*.mjs.rej' -print -quit | grep -q .; then
    echo "Phase 30B semantic contract validation found planning reject files after recovery." \
      | tee "$DIAG/phase30b-semantic-contract-failure.log" >&2
    find "$GEN/src/lib" -maxdepth 1 -type f -name 'planning-*.mjs.rej' -print \
      | tee -a "$DIAG/phase30b-semantic-contract-failure.log" >&2
    exit 2
  fi

  printf '%s\n' \
    'phase30b_semantic_contract=verified' \
    'phase30b_semantic_contract_validation=behavioral-postcondition-no-second-patch-replay' \
    'semantic_test_minimum=3' \
    > "$DIAG/phase30b-semantic-contract.txt"
