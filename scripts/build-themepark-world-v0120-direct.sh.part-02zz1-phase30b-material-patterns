  PHASE30B_MATERIAL_TRANSFORM="$ROOT/patches/v0120-phase30b/material-pattern-transform.mjs"
  PHASE30B_MATERIAL_TRANSFORM_SHA="2118630c515ca658dae9f07460cf282d8e0748cb17c0dc2b3644ae2fd771e654"
  [[ -f "$PHASE30B_MATERIAL_TRANSFORM" ]] || {
    echo "Missing Phase 30B material-pattern transform." | tee "$DIAG/phase30b-material-error.txt" >&2
    exit 2
  }
  phase30b_material_actual_sha="$(sha256sum "$PHASE30B_MATERIAL_TRANSFORM" | cut -d' ' -f1)"
  printf 'material_transform_expected=%s\nmaterial_transform_actual=%s\n' \
    "$PHASE30B_MATERIAL_TRANSFORM_SHA" "$phase30b_material_actual_sha" \
    | tee "$DIAG/phase30b-material-transform-checksum.txt"
  [[ "$phase30b_material_actual_sha" == "$PHASE30B_MATERIAL_TRANSFORM_SHA" ]] || {
    echo "Phase 30B material-pattern transform checksum mismatch." | tee "$DIAG/phase30b-material-error.txt" >&2
    exit 2
  }

  node "$PHASE30B_MATERIAL_TRANSFORM" --root "$GEN" \
    2>&1 | tee "$DIAG/phase30b-material-transform.log"
  node --check "$GEN/src/lib/fidelity.mjs"
  node --check "$GEN/src/lib/raster.mjs"
  node --check "$GEN/src/lib/mcworld.mjs"
  (
    cd "$GEN"
    node --test \
      test/material-pattern-recipes.test.mjs \
      test/appearance-vegetation.test.mjs \
      test/direct-world-palette-compatibility.test.mjs \
      2>&1 | tee "$DIAG/phase30b-material-pattern-tests.log"
  )

  printf '%s\n' \
    'material_pattern_engine=arbitrary-length-deterministic-weighted-palettes' \
    'asphalt=minecraft:gray_wool@60,minecraft:gray_concrete@40' \
    'brick=minecraft:terracotta@60,minecraft:jungle_planks@30,minecraft:packed_mud@10' \
    'stone=minecraft:stone@55,minecraft:cracked_stone_bricks@5,minecraft:stone_bricks@20,minecraft:andesite@15,minecraft:polished_andesite@5' \
    'grass=minecraft:grass_block@70,minecraft:moss_block@30' \
    'stone_note=provided weights totalled 85; remaining 15 assigned to primary stone rather than inventing a material' \
    'planning_qa=planning-derived geometry remains minecraft:pink_wool while provenance QA is active' \
    > "$DIAG/phase30b-material-pattern-policy.txt"
