 const old=`export function automaticCandidateToManifest(result, document) {\n  if (!result || !["accepted", "candidate"].includes(result.status) || !Array.isArray(result.points)) return null;\n  return {\n    method: result.status === "accepted" ? "automatic-linework-registration" : "automatic-linework-candidate",\n    page: Number(result.page || 1),\n    pageWidth: Number(result.pageWidth),\n    pageHeight: Number(result.pageHeight),\n    crs: String(result.crs || "EPSG:4326"),\n    points: result.points,\n    documentId: document.id,\n    confidence: Number(result.confidence || 0),\n    candidateLocation: result.candidateLocation || null,\n    quality: result.quality || null\n  };\n}`;
 const neu=`export function automaticCandidateToManifest(result, document) {\n  if (!result || !["accepted", "candidate"].includes(result.status) || !Array.isArray(result.points)) return null;\n  const base={method:result.status === "accepted" ? "automatic-linework-registration" : "automatic-linework-candidate",page:Number(result.page||1),pageWidth:Number(result.pageWidth),pageHeight:Number(result.pageHeight),crs:String(result.crs||"EPSG:4326"),points:result.points,documentId:document.id,confidence:Number(result.confidence||0),candidateLocation:result.candidateLocation||null,quality:result.quality||null};\n  base.alternatives=(Array.isArray(result.alternatives)?result.alternatives:[]).filter(c=>Array.isArray(c?.points)&&c?.candidateLocation).slice(0,12).map((c,i)=>({method:"automatic-linework-candidate",page:Number(c.page||base.page),pageWidth:Number(c.pageWidth||base.pageWidth),pageHeight:Number(c.pageHeight||base.pageHeight),crs:String(c.crs||base.crs),points:c.points,documentId:document.id,confidence:Number(c.confidence||0),candidateLocation:c.candidateLocation,quality:c.quality||null,alternativeRank:Number(c.alternativeRank??i+1)}));\n  return base;\n}`;
 s=repl(s,old,neu,'manifest alternatives');
