  PHASE21_B64="$ROOT/.phase21-planning-georeference.patch.gz.b64"
  PHASE21_PATCH="$ROOT/.phase21-planning-georeference.patch"
  PHASE21_PARTS=("$ROOT"/patches/v0120-phase21/phase21-planning-georeference.patch.gz.b64.part-*)
  PHASE21_EXPECTED_BLOBS=(
    067179691fcf7b3faffcbca0c6682a5681fbd811
    818d57643d8d0a1537c687c4eccc7b30a5c95e5f
    2669a2001b9fa63ae11a8d0fd6e31837b414891a
    19b97d21a421e9ab2f4c3570c7f5271c24730419
    cd51fe7879beac90a1784a60c229089cc116096d
  )
  [[ ${#PHASE21_PARTS[@]} -eq ${#PHASE21_EXPECTED_BLOBS[@]} ]] || {
    echo "Phase 21 planning georeference bundle part count mismatch." | tee -a "$DIAG/source-error.txt" >&2
    exit 2
  }
  : > "$PHASE21_B64"
  : > "$DIAG/phase21-patch-checksum.txt"
  for (( phase21_index=0; phase21_index<${#PHASE21_PARTS[@]}; phase21_index++ )); do
    phase21_part="${PHASE21_PARTS[$phase21_index]}"
    phase21_expected_blob="${PHASE21_EXPECTED_BLOBS[$phase21_index]}"
    phase21_actual_blob="$(git hash-object "$phase21_part")"
    printf 'part=%s expected_blob=%s actual_blob=%s\n' \
      "$(basename "$phase21_part")" "$phase21_expected_blob" "$phase21_actual_blob" \
      | tee -a "$DIAG/phase21-patch-checksum.txt"
    [[ "$phase21_actual_blob" == "$phase21_expected_blob" ]] || {
      echo "Phase 21 planning georeference bundle chunk mismatch: $(basename "$phase21_part")" | tee -a "$DIAG/source-error.txt" >&2
      exit 2
    }
    cat "$phase21_part" >> "$PHASE21_B64"
  done
  base64 --decode "$PHASE21_B64" | gzip -dc > "$PHASE21_PATCH"
  ACTUAL_PHASE21_PATCH_SHA="$(sha256sum "$PHASE21_PATCH" | cut -d' ' -f1)"
  printf 'assembled_sha256=%s\n' "$ACTUAL_PHASE21_PATCH_SHA" | tee -a "$DIAG/phase21-patch-checksum.txt"
  [[ "$ACTUAL_PHASE21_PATCH_SHA" == "d6a7b6762269e710cef9963f6a20bbf1c6def0d35bd62fbc85911527cf1cb20b" ]] || {
    echo "Phase 21 assembled patch checksum mismatch." | tee -a "$DIAG/source-error.txt" >&2
    exit 2
  }
  patch --batch --forward -d "$GEN" -p1 < "$PHASE21_PATCH" \
    2>&1 | tee "$DIAG/phase21-patch-apply.log"

  find "$GEN/src" "$GEN/scripts" "$GEN/test" -type f -name '*.mjs' -print0 \
    | xargs -0 -n1 node --check 2>&1 | tee "$DIAG/phase21-syntax-check.log"
  node --test test/planning-georeference.test.mjs \
    2>&1 | tee "$DIAG/phase21-planning-georeference-tests.log"

  node --test \
    test/planning-georeference.test.mjs \
