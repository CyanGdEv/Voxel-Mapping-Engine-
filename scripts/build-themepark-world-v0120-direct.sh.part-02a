  if [[ "${TPMAP_EA_TILED:-true}" == "true" && " ${SOURCE_ARGS[*]} " != *" --ea-tiled "* ]]; then
    SOURCE_ARGS+=(
      --ea-tiled
      --ea-tile-size-m "${TPMAP_EA_TILE_SIZE_M:-1000}"
      --ea-tile-concurrency "${TPMAP_EA_TILE_CONCURRENCY:-2}"
      --ea-tile-min-coverage "${TPMAP_EA_TILE_MIN_COVERAGE:-0.85}"
      --ea-tile-max-resolution-m "${TPMAP_EA_TILE_MAX_RESOLUTION_M:-2}"
      --ea-tile-threshold-m "${TPMAP_EA_TILE_THRESHOLD_M:-1500}"
    )
    [[ "${TPMAP_EA_TILE_FALLBACK_SINGLE:-true}" == "true" ]] && SOURCE_ARGS+=(--ea-tile-fallback-single)
  fi

  if [[ "${TPMAP_EA_TILED:-true}" == "true" && "${TPMAP_EA_RESOLUTION_BLEND:-true}" == "true" && " ${SOURCE_ARGS[*]} " != *" --ea-resolution-blend "* ]]; then
    SOURCE_ARGS+=(
      --ea-resolution-blend
      --ea-resolution-core-bbox "$BBOX"
      --ea-core-resolution-m "${TPMAP_EA_CORE_RESOLUTION_M:-1}"
      --ea-near-resolution-m "${TPMAP_EA_NEAR_RESOLUTION_M:-2}"
      --ea-outer-resolution-m "${TPMAP_EA_OUTER_RESOLUTION_M:-5}"
      --ea-near-distance-m "${TPMAP_EA_NEAR_DISTANCE_M:-750}"
      --ea-resolution-feather-m "${TPMAP_EA_RESOLUTION_FEATHER_M:-64}"
    )
  fi

  printf 'enabled=%s\ntile_size_m=%s\nconcurrency=%s\nminimum_coverage=%s\nmaximum_resolution_m=%s\nthreshold_m=%s\nfallback_single=%s\nresolution_blend=%s\ncore_resolution_m=%s\nnear_resolution_m=%s\nouter_resolution_m=%s\nnear_distance_m=%s\nfeather_m=%s\ncore_bbox=%s\n' \
    "${TPMAP_EA_TILED:-true}" "${TPMAP_EA_TILE_SIZE_M:-1000}" "${TPMAP_EA_TILE_CONCURRENCY:-2}" \
    "${TPMAP_EA_TILE_MIN_COVERAGE:-0.85}" "${TPMAP_EA_TILE_MAX_RESOLUTION_M:-2}" \
    "${TPMAP_EA_TILE_THRESHOLD_M:-1500}" "${TPMAP_EA_TILE_FALLBACK_SINGLE:-true}" \
    "${TPMAP_EA_RESOLUTION_BLEND:-true}" "${TPMAP_EA_CORE_RESOLUTION_M:-1}" \
    "${TPMAP_EA_NEAR_RESOLUTION_M:-2}" "${TPMAP_EA_OUTER_RESOLUTION_M:-5}" \
    "${TPMAP_EA_NEAR_DISTANCE_M:-750}" "${TPMAP_EA_RESOLUTION_FEATHER_M:-64}" "$BBOX" \
    > "$DIAG/terrain-tiling.txt"
