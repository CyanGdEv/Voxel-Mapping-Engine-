 const body=`export function automaticConsensusGroups(results, options = {}) {\n  const maxSeparationM=number(options.planningAutomaticRegistrationConsensusM,140,20,1000),minimumConfidence=number(options.planningAutomaticRegistrationMinConfidence,0.72,0.5,0.99),minimumDocuments=integer(options.planningAutomaticRegistrationConsensusDocuments,2,2,8),grouped=new Map();\n  for(const result of results||[]){const variants=registrationVariants(result,minimumConfidence);if(!variants.length)continue;const key=result.applicationReference||"unknown",list=grouped.get(key)||[];list.push({result,variants});grouped.set(key,list)}\n  const accepted=new Set(),selectedCandidates=new Map(),evidence=[];\n  for(const [applicationReference,entries] of grouped){let best=null;for(const entry of entries)for(const anchor of entry.variants){const members=[];for(const other of entries){const nearest=other.variants.map(candidate=>({candidate,distanceM:haversineM(anchor.candidateLocation,candidate.candidateLocation)})).filter(v=>v.distanceM<=maxSeparationM).sort((a,b)=>a.distanceM-b.distanceM||registrationVariantScore(b.candidate)-registrationVariantScore(a.candidate))[0];if(nearest)members.push({result:other.result,candidate:nearest.candidate,distanceM:nearest.distanceM})}const uniqueDocuments=new Set(members.map(m=>m.result.sourceSha256||m.result.id)),spreadM=members.length?Math.max(...members.map(m=>m.distanceM)):Infinity,quality=members.reduce((n,m)=>n+registrationVariantScore(m.candidate),0),score=uniqueDocuments.size*10000+quality*100-spreadM;if(!best||score>best.score)best={score,members,uniqueDocuments,spreadM}}\n    const consensusDocuments=best?.uniqueDocuments.size||0,isAccepted=consensusDocuments>=minimumDocuments;if(isAccepted)for(const m of best.members){accepted.add(m.result.id);selectedCandidates.set(m.result.id,m.candidate)}evidence.push({applicationReference,candidates:entries.length,candidateVariants:entries.reduce((n,e)=>n+e.variants.length,0),consensusDocuments,accepted:isAccepted,maximumSeparationM:maxSeparationM,selectedSpreadM:Number.isFinite(best?.spreadM)?Math.round(best.spreadM*10)/10:null,selectedAlternativeDocuments:isAccepted?best.members.filter(m=>Number(m.candidate.alternativeRank||0)>0).length:0});\n  }\n  return {accepted,selectedCandidates,evidence,minimumDocuments,minimumConfidence,maxSeparationM};\n}\nfunction registrationVariants(result,min){const p=result?.automaticCandidate;if(!p)return[];const out=[];for(const c of [p,...(Array.isArray(p.alternatives)?p.alternatives:[])]){if(!c?.candidateLocation||Number(c.confidence||0)<min)continue;if(out.some(x=>haversineM(x.candidateLocation,c.candidateLocation)<8))continue;out.push(c)}return out.slice(0,12)}\nfunction registrationVariantScore(c){const q=c?.quality||{};return Number(c?.confidence||0)*2+Number(q.f1||q.score||0)+Number(q.precision||0)*.25+Number(q.recall||0)*.25}\n\n`;
 return range(s,'export function automaticConsensusGroups(results, options = {}) {','export function extractScaleDenominators(text, pageWidth = null, pageHeight = null) {',body,'consensus');
}
export function transformPlanningAutoRegisterPython(s){
 s=repl(s,'    controls = control_points(best, image.shape, page_width, page_height, bbox, reference_size)\n    if not base_quality or len(controls) < 5:','    controls = control_points(best, image.shape, page_width, page_height, bbox, reference_size)\n    alternatives = ranked_registration_alternatives(candidates, image.shape, page_width, page_height, bbox, reference_size, location)\n    if not base_quality or len(controls) < 5:','python alternatives');
 s=repl(s,'        "candidateLocation": control_center(controls),\n        "quality": {','        "candidateLocation": control_center(controls),\n        "alternatives": alternatives,\n        "quality": {','python response');
