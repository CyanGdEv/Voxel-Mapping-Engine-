      import { tryCompileParkLandscapingVegetation as veg, tryCompileParkLandscapingTerrainDetail as terrain, compileParkLandscapingBarrierRun as barrier, landscapingCapabilities as caps } from "./src/lib/park-landscaping-fidelity.mjs";
      const elevationY=new Array(1600).fill(64),mask=new Array(1600).fill(1),base={minX:0,minZ:0,width:40,height:40,elevationY,mask,seed:77};
      const bedBlocks=[]; const bed=veg({...base,add:(...a)=>bedBlocks.push(a.at(-1)),feature:{kind:"vegetation",localGeometry:{type:"Polygon",coordinates:[[[4,4],[10,4],[10,9],[4,9],[4,4]]]},tags:{landuse:"flowerbed",edging:"yes",border_material:"brick"}}});
      if(!bed?.landscapeCells || bed.groundPlants<1 || !bedBlocks.some(b=>b==="minecraft:brick_slab")) throw new Error("flowerbed planting/edging test failed");
      const fernBlocks=[]; const fern=veg({...base,add:(...a)=>fernBlocks.push(a.at(-1)),feature:{kind:"vegetation",localGeometry:{type:"Point",coordinates:[12,12]},tags:{vegetation:"fern"}}});
      if(!fern || !fernBlocks.some(b=>["minecraft:fern","minecraft:tallgrass","minecraft:azalea"].includes(b))) throw new Error("fern groundcover test failed");
      const logBlocks=[]; const log=terrain({...base,add:(...a)=>logBlocks.push(a.at(-1)),feature:{kind:"terrain_detail",localGeometry:{type:"LineString",coordinates:[[15,15],[22,17]]},tags:{natural:"fallen_tree",diameter:"1.6"}}});
      if(!log?.fallenLogBlocks || !logBlocks.some(b=>b.endsWith("_slab"))) throw new Error("fallen log shaping test failed");
      const wallBlocks=[]; const retaining=barrier({add:(...a)=>wallBlocks.push(a.at(-1)),feature:{tags:{barrier:"retaining_wall",material:"stone",height:"3"}},x1:2,x2:8,z:20,terrainY:64,seed:1});
      if(!retaining || !wallBlocks.some(b=>b.endsWith("_stairs")) || !wallBlocks.some(b=>b.endsWith("_slab"))) throw new Error("retaining wall shaping test failed");
      const kerbBlocks=[]; const kerb=barrier({add:(...a)=>kerbBlocks.push(a.at(-1)),feature:{tags:{barrier:"kerb"}},x1:2,x2:5,z:22,terrainY:64,seed:1});
      if(!kerb || !kerbBlocks.length || !kerbBlocks.every(b=>b.endsWith("_slab"))) throw new Error("kerb slab test failed");
      const c=caps();
      for(const key of ["flowerbeds","ferns","longGrass","fallenLogs","planterEdges","retainingWalls","kerbs","terrainAwareEdging"]) if(!c[key]) throw new Error(`missing landscaping capability ${key}`);
      if(c.excludedStreetFurniture.join(",")!=="benches,drains,lamps,bins") throw new Error("street furniture exclusion policy failed");
      console.log("park_landscaping_runtime_test=PASS");
    ' 2>&1 | tee "$DIAG/park-landscaping-runtime-test.log"
  )

