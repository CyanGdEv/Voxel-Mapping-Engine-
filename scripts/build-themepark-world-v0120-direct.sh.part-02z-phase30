      test/planning-authority.test.mjs \
      test/planning-vector-fusion.test.mjs \
      test/planning-pink-qa.test.mjs \
      2>&1 | tee "$DIAG/phase30a-planning-authority-pink-qa-tests.log"
  )

  printf '%s\n' \
    'planning_geometry_authority=planning-drawing-vector' \
