      import { tryCompileParkVegetation as tree, tryCompileParkTerrainDetail as rock, compileParkBarrierRun as barrier, sceneryShapeCapabilities as caps } from "./src/lib/park-scenery-fidelity.mjs";
      const elevationY = new Array(400).fill(64), mask = new Array(400).fill(1);
      const treeBlocks=[]; const addTree=(...a)=>treeBlocks.push(a.at(-1));
      const t=tree({add:addTree,feature:{kind:"vegetation",localGeometry:{type:"Point",coordinates:[5,5]},tags:{species:"Quercus robur"},fidelity:{vegetation:{heightM:14}}},minX:0,minZ:0,width:20,height:20,elevationY,mask,seed:42});
      if(!t?.enhancedScenery || !treeBlocks.some(b=>b.endsWith("_stairs"))) throw new Error("tree shape/root stair test failed");
      const rockBlocks=[]; const r=rock({add:(...a)=>rockBlocks.push(a.at(-1)),feature:{kind:"terrain_detail",localGeometry:{type:"Point",coordinates:[8,8]},tags:{natural:"boulder",width:"5",height:"3"}},minX:0,minZ:0,width:20,height:20,elevationY,mask,seed:42});
      if(!r || !rockBlocks.some(b=>/_slab$|_stairs$|_wall$/.test(b))) throw new Error("boulder slab/stair/wall test failed");
      const fenceBlocks=[]; const handled=barrier({add:(...a)=>fenceBlocks.push(a.at(-1)),feature:{tags:{barrier:"wall",material:"stone"}},x1:0,x2:8,z:0,terrainY:64,seed:1});
      if(!handled || !fenceBlocks.some(b=>b.endsWith("_wall")) || !fenceBlocks.some(b=>b.endsWith("_slab"))) throw new Error("masonry wall/slab test failed");
      const c=caps(); if(!c.slabs||!c.stairs||!c.walls||!c.fences) throw new Error("scenery shape capability test failed");
      console.log("park_scenery_runtime_test=PASS");
    ' 2>&1 | tee "$DIAG/park-scenery-runtime-test.log"
