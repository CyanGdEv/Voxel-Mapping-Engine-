 if(!s.includes('def ranked_registration_alternatives(')){const a='\ndef render_reference(features: list[dict[str, Any]], bbox: dict[str, float], size: int):\n',i=s.indexOf(a);if(i<0)throw new Error('planning-area python insert missing');const h=`\ndef ranked_registration_alternatives(candidates, image_shape, page_width, page_height, bbox, reference_size, location):\n    selected=[]\n    raw=[]\n    for candidate in candidates:\n        if any(not distinct_candidate(candidate, prior) for prior in raw): continue\n        points=control_points(candidate,image_shape,page_width,page_height,bbox,reference_size)\n        if len(points)<5: continue\n        supported=location is not None and (candidate.get("locationOffsetM") or float("inf"))<=500\n        raw.append(candidate)\n        selected.append({"page":1,"pageWidth":float(page_width),"pageHeight":float(page_height),"crs":"EPSG:4326","points":points,"confidence":confidence_score(candidate,0.0,supported),"candidateLocation":control_center(points),"quality":compact_candidate(candidate),"alternativeRank":len(selected)+1})\n        if len(selected)>=12: break\n    return selected\n\n`;s=s.slice(0,i)+h+s.slice(i)}return s;
}
export function transformSourceFusion(s){
 const old='  planning.tags = { ...replaced.tags, ...planning.tags };\n';
 const neu=`  const retainedOsmTags = { ...replaced.tags };\n  const planningVectorRole = String(planning.tags?.planning_vector_role || planning.source?.planningVectorSubtype || "");\n  const authoritativePlanningPath = planning.source?.dataset === "planning-drawing-vector" && ["path", "road"].includes(planning.kind) && /^site-/.test(planningVectorRole);\n  if (authoritativePlanningPath) {\n    // Geometry authority must cross the fusion boundary, not stop at diagnostics.\n    // Update both sides of the replacement so every downstream consumer sees\n    // the accepted planning linework even if it retained the legacy object.\n    const planningGeometry = planning.localGeometry || planning.geometry || null;\n    if (planningGeometry) {\n      if (planning.localGeometry) replaced.localGeometry = planning.localGeometry;\n      if (planning.geometry) replaced.geometry = planning.geometry;\n      if (!replaced.localGeometry && planning.localGeometry) replaced.localGeometry = planning.localGeometry;\n      replaced.source = { ...(replaced.source || {}), geometryAuthority: "planning-drawing", replacedGeometryDataset: replaced.source?.dataset || null };\n      planning.source = { ...(planning.source || {}), geometryAuthority: "planning-drawing" };\n      planning.tags.planning_geometry_authority = "planning-drawing";\n    }\n    for (const key of ["surface","material","paving","colour","color","pattern","width","est_width","smoothness","tracktype"]) delete retainedOsmTags[key];\n    planning.tags.planning_surface_authority = "planning-drawing";\n  }\n  planning.tags = { ...retainedOsmTags, ...planning.tags };\n`;
 return repl(s,old,neu,'OSM appearance inheritance');
}
const testSource=`import test from 'node:test';\nimport assert from 'node:assert/strict';\nimport {readFile} from 'node:fs/promises';\nimport {__test as g} from '../src/lib/planning-georeference.mjs';\nimport {automaticConsensusGroups} from '../src/lib/planning-auto-registration.mjs';\ntest('drawing beats narrative',()=>{const c={score:125,role:'access-plan',applicationStatus:'approved',state:'unknown'};assert.ok(g.documentPriority({...c,score:120,role:'block-plan',state:'proposed',linkText:'373-95-4B Block Plan as Proposed showing Woodland path'})>g.documentPriority({...c,linkText:'S73 application - SW8 path proposals',text:{excerpt:'covering letter and archaeological statement'}}))});\ntest('joint consensus selects alternatives',()=>{const c=(lon,rank=0)=>({points:[{x:0,y:0,longitude:lon,latitude:52.98}],confidence:.88,candidateLocation:{longitude:lon,latitude:52.98},quality:{f1:.94,precision:.95,recall:.93},alternativeRank:rank});const r=automaticConsensusGroups([{id:'a',sourceSha256:'a',applicationReference:'x',automaticCandidate:{...c(-1.87),alternatives:[c(-1.8800,2)]}},{id:'b',sourceSha256:'b',applicationReference:'x',automaticCandidate:{...c(-1.89),alternatives:[c(-1.8802,2)]}}]);assert.equal(r.accepted.size,2);assert.equal(r.evidence[0].selectedAlternativeDocuments,2)});\ntest('site-plan path geometry authority crosses source-fusion boundary',async()=>{const s=await readFile(new URL('../src/lib/source-fusion.mjs',import.meta.url),'utf8');assert.match(s,/authoritativePlanningPath/);assert.match(s,/replaced\\.localGeometry = planning\\.localGeometry/);assert.match(s,/replaced\\.geometry = planning\\.geometry/);assert.match(s,/planning_geometry_authority/)});\n`;
async function validate(root){for(const [f,t] of [['src/lib/planning-georeference.mjs',MARKER],['src/lib/planning-auto-registration.mjs','selectedCandidates'],['src/tools/planning_auto_register.py','ranked_registration_alternatives'],['src/lib/source-fusion.mjs','planning_geometry_authority']])if(!(await readFile(path.join(root,f),'utf8')).includes(t))throw new Error(`${f} lacks ${t}`);if(!(await readFile(path.join(root,'test/planning-area-authority.test.mjs'),'utf8')).includes('geometry authority crosses source-fusion boundary'))throw new Error('planning-area geometry authority test missing')}
