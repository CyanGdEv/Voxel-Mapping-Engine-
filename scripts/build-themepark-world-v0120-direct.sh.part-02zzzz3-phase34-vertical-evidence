  # Phase 34 — resolve vertical evidence on the Phase 33 reconstruction graph.
  # This first slice is graph-only: legacy compiler feature objects are not
  # mutated, so block output changes only after a later explicit compiler cutover.
  PHASE34_INSTALLER="$ROOT/patches/v0120-phase34/install-vertical-evidence-engine.mjs"
  PHASE34_LOG="$DIAG/phase34-vertical-evidence.log"

  "$TPMAP_NODE_BIN" "$PHASE34_INSTALLER" --self-test 2>&1 | tee "$PHASE34_LOG"
  "$TPMAP_NODE_BIN" "$PHASE34_INSTALLER" --generator "$GEN" 2>&1 | tee -a "$PHASE34_LOG"
  "$TPMAP_NODE_BIN" "$PHASE34_INSTALLER" --generator "$GEN" --validate-only 2>&1 | tee -a "$PHASE34_LOG"

  "$TPMAP_NODE_BIN" --check "$GEN/src/lib/vertical-evidence-engine.mjs"
  "$TPMAP_NODE_BIN" --check "$GEN/src/lib/pipeline.mjs"
  (
    cd "$GEN"
    "$TPMAP_NODE_BIN" --test test/vertical-evidence-engine.test.mjs 2>&1 | tee -a "$PHASE34_LOG"
  )

  printf '%s\n' \
    'phase34_vertical_evidence=enabled' \
    'model=ground-base-top' \
    'authority=planning-explicit-over-derived-elevation' \
    'observations=building-ffl,ride-elevation,water-level,terrain-level' \
    'terrain=lidar-or-terrain-sampler-ground-evidence' \
    'conflicts=retained-and-reported' \
    'missing_values=unresolved-never-guessed' \
    'osm_policy=never-valid-vertical-world-evidence' \
    'compiler_cutover=graph-only-no-legacy-feature-mutation' \
    > "$DIAG/phase34-runtime-policy.txt"
