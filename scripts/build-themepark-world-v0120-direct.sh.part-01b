  PHASE20_B64="$ROOT/.phase20-planning-authority-discovery.patch.b64"
  PHASE20_PATCH="$ROOT/.phase20-planning-authority-discovery.patch"
  EXPECTED_PHASE20_PATCH_SHA="881974491fcf428db7e54f9787369ffaba5255c852061e2f0393198873f18c6d"
  cat "$ROOT"/patches/v0120-phase20/phase20.bundle.b64.part-* > "$PHASE20_B64"
  base64 --decode "$PHASE20_B64" > "$PHASE20_PATCH"
  ACTUAL_PHASE20_PATCH_SHA="$(sha256sum "$PHASE20_PATCH" | cut -d' ' -f1)"
  printf 'phase20_patch_expected=%s\nphase20_patch_actual=%s\n' \
    "$EXPECTED_PHASE20_PATCH_SHA" "$ACTUAL_PHASE20_PATCH_SHA" \
    | tee "$DIAG/phase20-patch-checksum.txt"
  [[ "$ACTUAL_PHASE20_PATCH_SHA" == "$EXPECTED_PHASE20_PATCH_SHA" ]] || {
    echo "Phase 20 planning authority discovery patch checksum mismatch." | tee -a "$DIAG/source-error.txt" >&2
    exit 2
  }
  patch --batch --forward -d "$GEN" -p1 < "$PHASE20_PATCH" \
    2>&1 | tee "$DIAG/phase20-patch-apply.log"
  find "$GEN/src" "$GEN/scripts" "$GEN/test" -type f -name '*.mjs' -print0 \
    | xargs -0 -n1 node --check 2>&1 | tee "$DIAG/phase20-syntax-check.log"
  node --test test/planning-authority-discovery.test.mjs \
    2>&1 | tee "$DIAG/phase20-planning-authority-discovery-tests.log"
