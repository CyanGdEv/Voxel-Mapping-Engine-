  # Final assembled-generator compatibility boundary. Test-shape compatibility is
  # canonicalized explicitly before validation; the legacy Alton live-repair
  # utility is no longer allowed to mutate the prepared generator.
  PREPARED_TEST_CONTRACT_FINALIZER="$ROOT/scripts/finalize-prepared-generator-test-contracts.mjs"
  ALTON_LIVE_CONTRACT_REPAIR="$ROOT/scripts/repair-alton-live-generator-contracts.mjs"
  ALTON_POSTMERGE_COMPAT_INSTALLER="$ROOT/patches/v0120-postmerge/install-alton-preflight-compatibility.mjs"
  ALTON_POSTMERGE_COMPAT_LOG="$DIAG/alton-postmerge-preflight-compatibility.log"

  # Normalize test-only contracts at an explicit boundary. This stage never
  # rewrites production source modules. It owns generated test import paths and
  # the Phase 30D-expanded candidate-set regression contract.
  "$TPMAP_NODE_BIN" "$PREPARED_TEST_CONTRACT_FINALIZER" --self-test 2>&1 | tee "$ALTON_POSTMERGE_COMPAT_LOG"
  "$TPMAP_NODE_BIN" "$PREPARED_TEST_CONTRACT_FINALIZER" --generator "$GEN" 2>&1 | tee -a "$ALTON_POSTMERGE_COMPAT_LOG"
  "$TPMAP_NODE_BIN" "$PREPARED_TEST_CONTRACT_FINALIZER" --generator "$GEN" --validate-only 2>&1 | tee -a "$ALTON_POSTMERGE_COMPAT_LOG"

  # Live repair is now a fail-closed validator only. Any remaining source module
  # that depends on repair must fail here so its owning Phase 34/35 template can
  # be corrected instead of silently mutating the assembled generator.
  "$TPMAP_NODE_BIN" "$ALTON_LIVE_CONTRACT_REPAIR" --generator "$GEN" --validate-only 2>&1 | tee -a "$ALTON_POSTMERGE_COMPAT_LOG"

  # The post-merge compatibility installer still owns the remaining vertical /
  # pipeline ordering compatibility in this slice. Test imports/cardinality have
  # already been canonicalized above and therefore must be no-ops here.
  "$TPMAP_NODE_BIN" "$ALTON_POSTMERGE_COMPAT_INSTALLER" --self-test 2>&1 | tee -a "$ALTON_POSTMERGE_COMPAT_LOG"
  "$TPMAP_NODE_BIN" "$ALTON_POSTMERGE_COMPAT_INSTALLER" --generator "$GEN" 2>&1 | tee -a "$ALTON_POSTMERGE_COMPAT_LOG"
  "$TPMAP_NODE_BIN" "$ALTON_POSTMERGE_COMPAT_INSTALLER" --generator "$GEN" --validate-only 2>&1 | tee -a "$ALTON_POSTMERGE_COMPAT_LOG"

  "$TPMAP_NODE_BIN" --check "$GEN/src/lib/vertical-evidence-engine.mjs"
  "$TPMAP_NODE_BIN" --check "$GEN/src/lib/pipeline.mjs"

  # Re-run the exact vertical evidence regression and the finalized planning
  # candidate-set contract after all current assembled-generator transforms.
  (
    cd "$GEN"
    "$TPMAP_NODE_BIN" --test \
      test/vertical-evidence-engine.test.mjs \
      test/planning-vectorize.test.mjs \
      test/planning-site-semantics.test.mjs \
      2>&1 | tee -a "$ALTON_POSTMERGE_COMPAT_LOG"
  )

  printf '%s\n' \
    'alton_postmerge_compatibility=enabled' \
    'live_generator_repair=validate-only-no-production-source-mutation' \
    'prepared_test_contract_finalizer=test-only' \
    'vertical_null_policy=null-undefined-empty-remain-unresolved-never-zero' \
    'phase34_35_vertical_order=terrain-surface,morphology,planning-association,buildings,vegetation,ride-profile' \
    'generated_test_imports=src-lib-not-test-local' \
    'phase30b_final_vector_contract=required-candidate-classes-not-obsolete-total-cardinality' \
    'authority_thresholds=unchanged' \
    > "$DIAG/alton-postmerge-preflight-policy.txt"
