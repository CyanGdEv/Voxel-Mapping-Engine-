  # Final assembled-generator compatibility boundary. Test-shape compatibility is
  # canonicalized explicitly before validation; production source contracts are
  # then checked by read-only validators with no write/delete filesystem APIs.
  PREPARED_TEST_CONTRACT_FINALIZER="$ROOT/scripts/finalize-prepared-generator-test-contracts.mjs"
  PREPARED_SOURCE_CONTRACT_VALIDATOR="$ROOT/scripts/validate-prepared-generator-source-contracts.mjs"
  ALTON_POSTMERGE_COMPAT_VALIDATOR="$ROOT/patches/v0120-postmerge/install-alton-preflight-compatibility.mjs"
  ALTON_POSTMERGE_COMPAT_LOG="$DIAG/alton-postmerge-preflight-compatibility.log"

  # Normalize test-only contracts at an explicit boundary. This stage never
  # rewrites production source modules. It owns generated test import paths and
  # the Phase 30D-expanded candidate-set regression contract.
  "$TPMAP_NODE_BIN" "$PREPARED_TEST_CONTRACT_FINALIZER" --self-test 2>&1 | tee "$ALTON_POSTMERGE_COMPAT_LOG"
  "$TPMAP_NODE_BIN" "$PREPARED_TEST_CONTRACT_FINALIZER" --generator "$GEN" 2>&1 | tee -a "$ALTON_POSTMERGE_COMPAT_LOG"
  "$TPMAP_NODE_BIN" "$PREPARED_TEST_CONTRACT_FINALIZER" --generator "$GEN" --validate-only 2>&1 | tee -a "$ALTON_POSTMERGE_COMPAT_LOG"

  # Source invariants are checked without mutation. Failures must be fixed in the
  # owning canonical Phase 30B/34/35 templates rather than repaired here.
  "$TPMAP_NODE_BIN" "$PREPARED_SOURCE_CONTRACT_VALIDATOR" --self-test 2>&1 | tee -a "$ALTON_POSTMERGE_COMPAT_LOG"
  "$TPMAP_NODE_BIN" "$PREPARED_SOURCE_CONTRACT_VALIDATOR" --generator "$GEN" 2>&1 | tee -a "$ALTON_POSTMERGE_COMPAT_LOG"

  # Post-merge compatibility is now validation-only. Fail closed if a future edit
  # reintroduces filesystem mutation capabilities into this boundary.
  if grep -Eq '\b(writeFile|appendFile|rm|unlink|rename|copyFile)\b' "$ALTON_POSTMERGE_COMPAT_VALIDATOR"; then
    echo "Postmerge compatibility boundary contains a forbidden write/delete API." \
      | tee -a "$ALTON_POSTMERGE_COMPAT_LOG" >&2
    exit 2
  fi
  "$TPMAP_NODE_BIN" "$ALTON_POSTMERGE_COMPAT_VALIDATOR" --self-test 2>&1 | tee -a "$ALTON_POSTMERGE_COMPAT_LOG"
  "$TPMAP_NODE_BIN" "$ALTON_POSTMERGE_COMPAT_VALIDATOR" --generator "$GEN" 2>&1 | tee -a "$ALTON_POSTMERGE_COMPAT_LOG"

  "$TPMAP_NODE_BIN" --check "$GEN/src/lib/vertical-evidence-engine.mjs"
  "$TPMAP_NODE_BIN" --check "$GEN/src/lib/pipeline.mjs"

  # Re-run the exact vertical evidence regression and the finalized planning
  # candidate-set contract after all canonical assembled-generator transforms.
  (
    cd "$GEN"
    "$TPMAP_NODE_BIN" --test \
      test/vertical-evidence-engine.test.mjs \
      test/planning-vectorize.test.mjs \
      test/planning-site-semantics.test.mjs \
      2>&1 | tee -a "$ALTON_POSTMERGE_COMPAT_LOG"
  )

  printf '%s\n' \
    'alton_postmerge_compatibility=validation-only' \
    'postmerge_source_mutation=disabled' \
    'live_generator_repair=removed-from-production-path' \
    'prepared_source_contract_validator=read-only' \
    'prepared_test_contract_finalizer=test-only' \
    'vertical_source_handoff=owned-by-phase34-vertical-installer' \
    'vertical_null_policy=null-undefined-empty-remain-unresolved-never-zero' \
    'phase34_35_vertical_order=terrain-surface,morphology,planning-association,buildings,vegetation,ride-profile' \
    'generated_test_imports=src-lib-not-test-local' \
    'phase30b_final_vector_contract=required-candidate-classes-not-obsolete-total-cardinality' \
    'authority_thresholds=unchanged' \
    > "$DIAG/alton-postmerge-preflight-policy.txt"
